  // —— 纳西妲 草 ——
  nahidaE(f,tg){
    if(!tg) return;
    const nx=Math.sign(tg.x-f.x)||1, ny=Math.sign(tg.y-f.y)||0;
    this.dealDamage(tg,f,nx,ny,1.7);
    let chained=0;
    for(const o of this.fighters){
      if(chained>=2||o.dead||o.team===f.team||o===tg) continue;
      if(Math.hypot(o.x-tg.x,o.y-tg.y)<190+o.r){
        this.dealDamage(o,f,Math.sign(o.x-tg.x)||1,Math.sign(o.y-tg.y)||0,0.7);
        for(let i=0;i<6;i++){
          const t=Math.random();
          this.fx('particle', {x:tg.x+(o.x-tg.x)*t,y:tg.y+(o.y-tg.y)*t,
            vx:(Math.random()-0.5)*60,vy:(Math.random()-0.5)*60,life:0.5,r:2.5,color:'#b8e88a'});
        }
        chained++;
      }
    }
  }
  nahidaQ(f){
    this.skillAoe(f,f.x,f.y,1e9,1.2,o=>{
      for(let i=0;i<6;i++){
        this.fx('particle', {x:o.x+(Math.random()*26-13),y:o.y+(Math.random()*26-13),
          vx:Math.random()*40-20,vy:Math.random()*40-20,life:0.6,r:2.5+Math.random()*2,color:'#6fbf44'});
      }
    });
    this.fx('shock', {x:f.x,y:f.y,r:f.r+6,life:0.55,vr:380,color:'#b8e88a'});
  }

