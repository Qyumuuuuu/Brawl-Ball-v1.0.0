function renderCropEditor(){
  const img=avatarImgs[cropEditId];
  const g=cropStage.getContext('2d'), S=cropStage.width;
  g.clearRect(0,0,S,S);
  g.fillStyle='#0b1420'; g.fillRect(0,0,S,S);
  const cx=S/2, cy=S/2, d=S/2;
  if(img&&img.complete&&img.naturalWidth>0){
    drawFace(g,img,cx,cy,d,cropEdit);
    g.save();
    g.strokeStyle='rgba(255,215,106,.9)'; g.lineWidth=2.5;
    g.beginPath(); g.arc(cx,cy,d-1,0,Math.PI*2); g.stroke();
    g.restore();
  }else{
    g.fillStyle='#2a3a55'; g.font='20px "Noto Sans SC",sans-serif'; g.textAlign='center'; g.textBaseline='middle';
    g.fillText('素材加载中…',cx,cy);
  }
  // 圆形最终效果预览
  const pg=cropPre.getContext('2d'), PS=cropPre.width;
  pg.clearRect(0,0,PS,PS);
  const pc=PS/2, pd=PS/2-2;
  pg.beginPath(); pg.arc(pc,pc,pd,0,Math.PI*2); pg.clip();
  const r=ROSTER.find(x=>x.id===cropEditId);
  if(img&&img.complete&&img.naturalWidth>0){
    drawFace(pg,img,pc,pc,pd,cropEdit);
  }else{
    pg.fillStyle=ELEM[r.elem].c; pg.fill();
    pg.fillStyle='#fff'; pg.font='900 18px "Noto Sans SC",sans-serif'; pg.textAlign='center'; pg.textBaseline='middle';
    pg.fillText(fbChars(r.name),pc,pc+1);
  }
  pg.restore();
  $('#crop-zoom-val').textContent=cropEdit.scale.toFixed(1)+'x';
}

/* 拖拽移动图片（图片跟随鼠标） */
function cropStagePos(e){
  const ev=e.touches&&e.touches.length?e.touches[0]:e;
  const rect=cropStage.getBoundingClientRect();
  return {x:ev.clientX-rect.left, y:ev.clientY-rect.top};
}
cropStage.addEventListener('pointerdown',e=>{
  if(!cropEditId) return;
  e.preventDefault();
  const p=cropStagePos(e);
  cropDrag={sx:p.x, sy:p.y, crop:Object.assign({},cropEdit)};
  try{ cropStage.setPointerCapture(e.pointerId); }catch(err){}
});
cropStage.addEventListener('pointermove',e=>{
  if(!cropDrag) return;
  e.preventDefault();
  const img=avatarImgs[cropEditId];
  if(!img||!img.complete||!img.naturalWidth) return;
  const p=cropStagePos(e), dx=p.x-cropDrag.sx, dy=p.y-cropDrag.sy;
  const iw=img.naturalWidth, ih=img.naturalHeight;
  // 与 drawFace 相同的缩放：1 源像素 = s 个 stage 像素，窗口中心 = 源像素 ox*iw / oy*ih
  const s=(cropEdit.scale*(cropStage.width/2))/Math.min(iw,ih);
  cropEdit.ox=clampV(cropDrag.crop.ox-dx/(s*iw),0.12,0.88);
  cropEdit.oy=clampV(cropDrag.crop.oy-dy/(s*ih),0.04,0.96);
  renderCropEditor();
});
cropStage.addEventListener('pointerup',()=>{ cropDrag=null; });
cropStage.addEventListener('wheel',e=>{
  if(!cropEditId) return;
  e.preventDefault();
  const k=e.deltaY<0?1.12:1/1.12;
  cropEdit.scale=clampV(cropEdit.scale*k,1,100);
  $('#crop-zoom').value=cropEdit.scale;
  renderCropEditor();
},{passive:false});

$('#crop-zoom').addEventListener('input',()=>{
  if(!cropEditId) return;
