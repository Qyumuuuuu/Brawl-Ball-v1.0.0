<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>原神 · 元素角斗场 v3.5</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpolygon points='12,1 23,12 12,23 1,12' fill='%23c9a959'/%3E%3Cpolygon points='12,5 19,12 12,19 5,12' fill='%230b1420'/%3E%3C/svg%3E">
<link rel="stylesheet" href="https://miaoda.feishu.cn/fonts/css2?family=Noto+Serif+SC:wght@600;700;900&family=Noto+Sans+SC:wght@400;500;700&display=swap">
<style>
/* ===== 基础 ===== */
:root{
  --bg:#0b1420; --bg2:#101d2e; --panel:#122238; --line:#c9a959; --line-dim:rgba(201,169,89,.35);
  --ink:#e8e2d4; --ink-dim:#a9b2bd; --gold:#d9b56c; --gold-bright:#f2d389;
  --team-red:#e0533d; --team-blue:#4a8fe0;
  --pyro:#e85d3a; --hydro:#3a9fe0; --electro:#b06fd8; --anemo:#4cc9a0; --geo:#d4a94e; --dendro:#6fbf44; --cryo:#7fd4e8;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  background:
    radial-gradient(1200px 600px at 15% -10%, rgba(201,169,89,.10), transparent 60%),
    radial-gradient(900px 500px at 90% 110%, rgba(59,130,180,.12), transparent 60%),
    var(--bg);
  color:var(--ink); font-family:'Noto Sans SC',system-ui,-apple-system,'Segoe UI',sans-serif;
  overflow:hidden;
}
h1,h2,h3{font-family:'Noto Serif SC',serif}
button{font-family:inherit;cursor:pointer}
:focus-visible{outline:2px solid var(--gold-bright);outline-offset:2px}

/* ===== 视图容器 ===== */
.view{display:none;height:100%;flex-direction:column}
.view.active{display:flex}
#app{height:100vh;height:100dvh}
.svg-defs{position:absolute;width:0;height:0;overflow:hidden}
.img-preload{display:none}
.toast{
  position:fixed;top:18px;left:50%;transform:translateX(-50%);z-index:50;
  background:rgba(11,20,32,.94);border:1px solid var(--line);color:var(--gold-bright);
  padding:10px 22px;border-radius:8px;font-size:14px;box-shadow:0 6px 24px rgba(0,0,0,.5);
  opacity:0;transition:opacity .25s;pointer-events:none;
}
.toast.show{opacity:1}

/* ===== 头像位置调节器（选人界面） ===== */
.crop-mask{position:fixed;inset:0;background:rgba(5,10,18,.78);z-index:90;display:none;align-items:center;justify-content:center;padding:16px}
.crop-mask.open{display:flex}
.crop-panel{
  width:min(900px,96vw);max-height:92vh;display:flex;flex-direction:column;overflow:hidden;
  background:linear-gradient(180deg,#131f33,#0b1420);border:1px solid var(--line);border-radius:14px;box-shadow:0 18px 60px rgba(0,0,0,.6);
}
.crop-head{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--line-dim)}
.crop-title{font-size:16px;font-weight:800;color:var(--gold-bright)}
.crop-sub{font-size:12px;color:var(--ink-dim);margin-left:auto;letter-spacing:.02em}
.crop-body{display:grid;grid-template-columns:1fr 236px;gap:14px;padding:14px 16px;flex:1;min-height:0}
.crop-stage-wrap{position:relative;display:flex;align-items:center;justify-content:center;min-height:0}
.crop-stage{width:min(100%,54vh);aspect-ratio:1/1;background:#0b1420;border:1px solid var(--line-dim);border-radius:10px;touch-action:none;cursor:grab}
.crop-stage:active{cursor:grabbing}
.crop-ring{
  position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(100%,54vh);aspect-ratio:1/1;
  border-radius:50%;pointer-events:none;border:2px dashed rgba(255,215,106,.85);
  box-shadow:0 0 0 9999px rgba(5,10,18,.5);
}
.crop-side{display:flex;flex-direction:column;gap:10px;min-width:0}
.crop-prev-wrap{display:flex;flex-direction:column;align-items:center;gap:6px}
.crop-preview{width:120px;height:120px;border-radius:50%;border:2px solid var(--gold);background:#0b1420;box-shadow:0 0 18px rgba(201,169,89,.25)}
.crop-prev-label{font-size:11px;color:var(--ink-dim)}
.crop-row{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--ink-dim)}
.crop-row input[type=range]{flex:1}
.crop-zoom-val{min-width:4em;text-align:right;color:var(--gold);font-variant-numeric:tabular-nums}
.crop-hint{font-size:11px;color:rgba(169,178,189,.65);line-height:1.6;padding-top:2px}
.crop-actions{display:flex;gap:8px;margin-top:auto}
.crop-actions .btn{flex:1;padding:9px 6px;font-size:13px}
@media (max-width:640px){
  .crop-body{grid-template-columns:1fr}
  .crop-stage{width:100%;max-height:34vh}
  .crop-ring{width:100%;max-height:34vh}
  .crop-side{flex-direction:row;flex-wrap:wrap;align-items:center}
  .crop-preview{width:84px;height:84px}
  .crop-actions{width:100%}
}

/* ===== 视图1：选人 ===== */
#view-select{overflow-y:auto}
.sel-head{padding:22px 20px 6px;text-align:center}
.sel-head h1{font-size:clamp(24px,4.2vw,40px);letter-spacing:.08em;font-weight:900;color:var(--gold-bright);text-shadow:0 0 18px rgba(242,211,137,.35),0 2px 0 rgba(0,0,0,.6)}
.sel-head .sub{margin-top:8px;font-size:clamp(12px,1.6vw,15px);color:var(--ink-dim);letter-spacing:.12em}
.sel-head .rule{margin-top:6px;font-size:12px;color:rgba(169,178,189,.75)}

/* 场地设置 */
.field-panel{
  margin:16px auto 0;width:min(980px,94%);background:linear-gradient(180deg,rgba(18,34,56,.9),rgba(11,20,32,.92));
  border:1px solid var(--line-dim);border-radius:12px;padding:12px 16px;box-shadow:0 10px 30px rgba(0,0,0,.4);
}
.field-title{display:flex;align-items:center;gap:8px;font-size:14px;color:var(--gold);letter-spacing:.14em;margin-bottom:10px}
.field-title::before{content:'';width:14px;height:14px;background:linear-gradient(135deg,var(--gold),var(--gold-bright));clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%)}
.field-rows{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.field-row{display:flex;align-items:center;gap:10px;font-size:12px;color:var(--ink-dim)}
.field-row label{flex:none;width:3.5em}
.theme-btns{display:flex;gap:8px;flex-wrap:wrap}
.theme-btn{padding:4px 12px;border-radius:8px;border:1px solid var(--line-dim);background:rgba(255,255,255,.03);color:var(--ink-dim);font-size:12px;cursor:pointer;transition:all .18s}
.theme-btn:hover{border-color:var(--gold);color:var(--gold-bright)}
.theme-btn.on{border-color:var(--gold);background:rgba(201,169,89,.16);color:var(--gold-bright);box-shadow:0 0 10px rgba(201,169,89,.25)}
input[type=range]{flex:1;min-width:0;-webkit-appearance:none;appearance:none;height:6px;border-radius:3px;background:linear-gradient(90deg,var(--line-dim),var(--line-dim));outline-offset:4px}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:16px;height:16px;border-radius:50%;background:var(--gold-bright);border:2px solid #fff2;box-shadow:0 0 6px rgba(242,211,137,.6);cursor:pointer}
input[type=range]::-moz-range-thumb{width:16px;height:16px;border-radius:50%;background:var(--gold-bright);border:2px solid #fff2;cursor:pointer}
.field-val{flex:none;min-width:52px;text-align:right;font-variant-numeric:tabular-nums;color:var(--gold-bright);font-size:12px}

/* 两队阵容 */
.teams-wrap{display:grid;grid-template-columns:1fr 1fr;gap:14px;width:min(980px,94%);margin:14px auto 0}
.team-panel{background:linear-gradient(180deg,rgba(18,34,56,.9),rgba(11,20,32,.92));border-radius:12px;padding:12px 14px 14px;box-shadow:0 10px 30px rgba(0,0,0,.4)}
.team-panel.red{border:1px solid rgba(224,83,61,.55)}
.team-panel.blue{border:1px solid rgba(74,143,224,.55)}
.team-title{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:700;letter-spacing:.18em;margin-bottom:10px}
.team-panel.red .team-title{color:#ff8a72}
.team-panel.blue .team-title{color:#7ab6f5}
.team-title .dot{width:12px;height:12px;border-radius:50%}
.team-panel.red .dot{background:var(--team-red);box-shadow:0 0 8px rgba(224,83,61,.8)}
.team-panel.blue .dot{background:var(--team-blue);box-shadow:0 0 8px rgba(74,143,224,.8)}
.team-slots{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.slot{
  min-height:138px;border:1px dashed rgba(201,169,89,.35);border-radius:10px;background:rgba(201,169,89,.04);
  display:flex;align-items:center;justify-content:center;color:rgba(169,178,189,.55);font-size:12px;position:relative;
}
.slot.filled{border-style:solid;background:linear-gradient(180deg,rgba(18,34,56,.95),rgba(11,20,32,.95))}
.team-panel.red .slot.filled{border-color:rgba(224,83,61,.6)}
.team-panel.blue .slot.filled{border-color:rgba(74,143,224,.6)}
.slot .pick-body{width:100%;padding:8px 10px}
.pick-top{display:flex;align-items:center;gap:8px;margin-bottom:6px}
.pick-avatar{width:42px;height:42px;border-radius:50%;border:2px solid var(--line);object-fit:cover;flex:none}
.pick-meta{flex:1;min-width:0}
.pick-name{font-size:13px;font-weight:700;display:flex;align-items:center;gap:4px}
.pick-elem{font-size:10px;color:var(--ink-dim)}
.pick-rm{width:24px;height:24px;border-radius:50%;border:1px solid var(--line-dim);background:transparent;color:var(--ink-dim);font-size:13px;line-height:1;flex:none}
.pick-rm:hover{color:var(--danger,#e85d3a);border-color:#e85d3a}
.pick-row{display:flex;align-items:center;gap:6px;margin-top:3px;font-size:10px;color:var(--ink-dim)}
.pick-row label{flex:none;width:2em}
.pick-row input{flex:1;min-width:0;height:5px}
.pick-val{flex:none;min-width:52px;text-align:right;font-variant-numeric:tabular-nums;color:var(--gold-bright);font-size:11px}

.squad-actions{display:flex;justify-content:center;gap:14px;width:min(980px,94%);margin:16px auto 0}
.btn{
  min-height:44px;padding:0 30px;border-radius:8px;font-size:15px;letter-spacing:.1em;font-weight:700;
  border:1px solid var(--line);background:linear-gradient(180deg,rgba(201,169,89,.25),rgba(201,169,89,.08));color:var(--gold-bright);
  transition:transform .12s,box-shadow .12s,opacity .2s;
}
.btn:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(201,169,89,.28)}
.btn:active{transform:translateY(0)}
.btn.primary{background:linear-gradient(180deg,#e8c877,#c9a959);color:#14100a}
.btn.ghost{background:transparent;border-color:var(--line-dim);color:var(--ink-dim)}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none;box-shadow:none}

/* 角色池 */
.roster{width:min(980px,94%);margin:18px auto 0;display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;padding-bottom:30px}
.char-card{
  position:relative;border:1px solid rgba(201,169,89,.22);border-radius:12px;background:linear-gradient(180deg,rgba(18,34,56,.85),rgba(11,20,32,.9));
  padding:12px 10px 10px;text-align:center;cursor:pointer;transition:border-color .15s,transform .15s,box-shadow .15s;user-select:none;
}
.char-card:hover{transform:translateY(-2px);border-color:rgba(201,169,89,.6)}
.char-card.red{border-color:var(--team-red);box-shadow:0 0 0 1px var(--team-red),0 8px 22px rgba(224,83,61,.25);background:linear-gradient(180deg,rgba(18,34,56,.85),rgba(60,20,14,.5))}
.char-card.blue{border-color:var(--team-blue);box-shadow:0 0 0 1px var(--team-blue),0 8px 22px rgba(74,143,224,.25);background:linear-gradient(180deg,rgba(18,34,56,.85),rgba(10,30,54,.5))}
.char-avatar{width:72px;height:72px;border-radius:50%;object-fit:cover;border:2px solid var(--line-dim);box-shadow:0 4px 14px rgba(0,0,0,.5)}
.char-card.red .char-avatar{border-color:var(--team-red)}
.char-card.blue .char-avatar{border-color:var(--team-blue)}
.char-name{margin-top:8px;font-size:14px;font-weight:700}
.char-title{font-size:11px;color:var(--ink-dim);margin-top:2px}
.char-elem{position:absolute;top:8px;right:8px;width:24px;height:24px;filter:drop-shadow(0 0 4px rgba(0,0,0,.6))}
.elem-img{width:18px;height:18px;display:inline-block;vertical-align:-3px;background-size:contain;background-repeat:no-repeat;background-position:center}
.elem-pyro{background-image:url(assets/elements/pyro.png)}
.elem-hydro{background-image:url(assets/elements/hydro.png)}
.elem-electro{background-image:url(assets/elements/electro.png)}
.elem-cryo{background-image:url(assets/elements/cryo.png)}
.elem-anemo{background-image:url(assets/elements/anemo.png)}
.elem-geo{background-image:url(assets/elements/geo.png)}
.elem-dendro{background-image:url(assets/elements/dendro.png)}
.char-tag{position:absolute;top:8px;left:8px;font-size:10px;padding:1px 7px;border-radius:10px;background:rgba(11,20,32,.85);letter-spacing:.08em}
.char-card.red .char-tag{color:#ff8a72;border:1px solid rgba(224,83,61,.7)}
.char-card.blue .char-tag{color:#7ab6f5;border:1px solid rgba(74,143,224,.7)}
.char-card:not(.red):not(.blue) .char-tag{display:none}
/* 头像位置调节按钮（角色卡右下角） */
.char-crop{
  position:absolute;right:6px;bottom:6px;width:22px;height:22px;padding:0;border-radius:50%;
  border:1px solid rgba(201,169,89,.55);background:rgba(11,20,32,.92);color:var(--gold-bright);
  display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:3;
}
.char-crop:hover{background:rgba(30,44,70,.95);border-color:var(--gold);transform:scale(1.12)}
.char-crop svg{width:13px;height:13px}
.char-tip{margin:14px auto 0;width:min(980px,94%);text-align:center;font-size:11px;color:rgba(169,178,189,.7);padding-bottom:6px}
.char-tip.rxn{color:rgba(242,211,137,.85);padding-bottom:24px}

/* ===== 视图2：战斗 ===== */
#view-battle.active{padding:10px 12px 12px;gap:10px;display:grid;grid-template-columns:auto 1fr auto;grid-template-rows:1fr auto auto;grid-template-areas:"red arena blue" "bar bar bar" "ctl ctl ctl"}
.hud-side{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;min-width:0}
#hud-red{grid-area:red}
#hud-blue{grid-area:blue}
.arena-wrap{grid-area:arena}
.skillbar{grid-area:bar}
.hud-row{display:flex;flex-direction:column;gap:8px;align-items:center;width:100%}
.team-label{font-size:12px;font-weight:700;letter-spacing:.1em;padding:4px 12px;border-radius:14px;flex:none}
.team-label.red{color:#ff8a72;border:1px solid rgba(224,83,61,.7);background:rgba(224,83,61,.12)}
.team-label.blue{color:#7ab6f5;border:1px solid rgba(74,143,224,.7);background:rgba(74,143,224,.12)}
.hud-card{
  display:flex;align-items:center;gap:9px;background:linear-gradient(180deg,rgba(22,38,64,.94),rgba(11,20,32,.96));
  border:1px solid var(--line-dim);border-radius:10px;padding:7px 11px;min-width:210px;flex:0 1 auto;
  box-shadow:0 4px 14px rgba(0,0,0,.38);
}
.hud-card.red{border-color:rgba(224,83,61,.55)}
.hud-card.blue{border-color:rgba(74,143,224,.55)}
.hud-card.dead{opacity:.5;filter:grayscale(1)}
.hud-card{cursor:pointer;transition:border-color .15s,box-shadow .15s}
.hud-card.selected{border-color:var(--gold-bright);box-shadow:0 0 0 1px var(--gold-bright),0 0 14px rgba(242,211,137,.4)}
.hud-avatar{width:34px;height:34px;border-radius:50%;object-fit:cover;border:2px solid var(--line);flex:none;transition:box-shadow .15s}
.hud-card.red .hud-avatar{border-color:rgba(224,83,61,.85);box-shadow:0 0 8px rgba(224,83,61,.35)}
.hud-card.blue .hud-avatar{border-color:rgba(74,143,224,.85);box-shadow:0 0 8px rgba(74,143,224,.35)}
.hud-card.selected .hud-avatar{border-color:var(--gold-bright);box-shadow:0 0 10px rgba(242,211,137,.5)}
.hud-main{flex:1;min-width:0}
.hud-name{display:flex;align-items:center;gap:5px;font-size:12px;font-weight:700}
.hud-name .elem-ic{width:16px;height:16px}
.hud-stats{font-size:10px;color:var(--ink-dim);font-variant-numeric:tabular-nums;margin-top:1px}
.hud-bar{position:relative;height:10px;border-radius:5px;background:rgba(0,0,0,.52);margin-top:4px;overflow:hidden;border:1px solid rgba(255,255,255,.1);box-shadow:inset 0 1px 3px rgba(0,0,0,.6)}
.hud-ghost,.hud-fill{position:absolute;top:0;left:0;height:100%;border-radius:5px;transition:width .12s linear}
.hud-ghost{background:rgba(255,255,255,.35);box-shadow:0 0 5px rgba(255,255,255,.25)}
.hud-fill{background:var(--team-c,#4a8fe0)}
.hud-fill::after{content:'';position:absolute;inset:0;border-radius:5px;background:linear-gradient(180deg,rgba(255,255,255,.38),rgba(255,255,255,0) 48%)}
.hud-ebar{position:relative;height:5px;border-radius:3px;background:rgba(0,0,0,.52);margin-top:3px;overflow:hidden;border:1px solid rgba(255,255,255,.07);box-shadow:inset 0 1px 2px rgba(0,0,0,.55)}
.hud-ebar .hud-fill{background:linear-gradient(90deg,#b08a3a,#ffe9a8);box-shadow:0 0 6px rgba(242,211,137,.45)}
.hud-en{font-size:9px;color:var(--ink-dim);font-variant-numeric:tabular-nums;margin-top:2px}
.hud-en.full{color:var(--gold-bright);text-shadow:0 0 8px rgba(242,211,137,.65)}
/* 队伍汇总：填满两侧 HUD 卡片下方的空白 */
.team-stats{
  display:grid;grid-template-columns:1fr 1fr;gap:5px 12px;width:100%;margin-top:4px;padding:8px 11px;
  border:1px solid var(--line-dim);border-radius:10px;background:linear-gradient(180deg,rgba(18,34,56,.72),rgba(11,20,32,.78));
  font-size:10px;color:var(--ink-dim);font-variant-numeric:tabular-nums;box-shadow:0 4px 14px rgba(0,0,0,.28);
}
.team-stats.red{border-color:rgba(224,83,61,.4)}
.team-stats.blue{border-color:rgba(74,143,224,.4)}
.team-stats .ts{display:flex;justify-content:space-between;gap:6px;align-items:baseline}
.team-stats .ts b{color:var(--gold-bright);font-size:11px;font-weight:700}
.team-stats .ts span{white-space:nowrap}
.sb-btn.q.ready{border-color:var(--gold-bright);color:var(--gold-bright);box-shadow:0 0 10px rgba(242,211,137,.4)}
.slot[data-empty]{cursor:pointer}
.slot[data-empty]:hover{border-color:rgba(201,169,89,.7);color:var(--gold-bright);background:rgba(201,169,89,.09)}
.arena-wrap{flex:1;position:relative;min-height:0;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#0a121e;box-shadow:0 10px 34px rgba(0,0,0,.5),inset 0 0 34px rgba(0,0,0,.5)}
#arena{position:absolute;inset:0;width:100%;height:100%;display:block}
.banner{
  position:absolute;top:14%;left:50%;transform:translateX(-50%);z-index:5;pointer-events:none;
  font-family:'Noto Serif SC',serif;font-size:clamp(18px,3.2vw,30px);font-weight:900;letter-spacing:.14em;
  text-shadow:0 0 22px rgba(242,211,137,.5),0 3px 0 rgba(0,0,0,.55);white-space:nowrap;
  opacity:0;transition:opacity .3s;
}
.banner.show{opacity:1;animation:bannerPop .45s cubic-bezier(.22,1,.36,1)}
@keyframes bannerPop{0%{transform:translateX(-50%) scale(.6);opacity:0}100%{transform:translateX(-50%) scale(1);opacity:1}}
.banner.kill{color:#ff6a52;text-shadow:0 0 26px rgba(255,90,70,.6),0 3px 0 rgba(0,0,0,.55)}
.banner.win{color:var(--gold-bright);text-shadow:0 0 26px rgba(242,211,137,.65),0 3px 0 rgba(0,0,0,.55)}
/* ===== 观战信息层：团队拔河条 / 战斗计时 / 击杀播报 ===== */
.tug{
  position:absolute;top:8px;left:50%;transform:translateX(-50%);width:min(560px,88%);
  display:flex;align-items:center;gap:8px;z-index:4;pointer-events:none;
  font-size:11px;letter-spacing:.05em;font-variant-numeric:tabular-nums;
}
.tug-name{flex:none;font-weight:700;text-shadow:0 1px 3px rgba(0,0,0,.8)}
.tug-name.red{color:#ff8a72}
.tug-name.blue{color:#7ab6f5}
.tug-bar{position:relative;flex:1;height:9px;border-radius:5px;background:rgba(0,0,0,.55);border:1px solid rgba(255,255,255,.16);overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.5)}
.tug-bar::after{content:'';position:absolute;left:50%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.55);z-index:2}
.tug-fill{position:absolute;top:0;bottom:0;transition:width .2s linear}
#tug-red{left:0;background:linear-gradient(90deg,#c8462f,#ff8a72);box-shadow:0 0 8px rgba(224,83,61,.5)}
#tug-blue{right:0;background:linear-gradient(270deg,#3a78c8,#7ab6f5);box-shadow:0 0 8px rgba(74,143,224,.5)}
.battle-clock{
  position:absolute;left:10px;bottom:8px;z-index:4;pointer-events:none;padding:2px 8px;border-radius:5px;
  font-size:11px;font-variant-numeric:tabular-nums;color:rgba(232,226,212,.8);
  background:rgba(8,14,24,.62);border:1px solid rgba(255,255,255,.12);letter-spacing:.04em;
}
.battle-clock.shrink{color:#ffb3a3;border-color:rgba(224,83,61,.55);text-shadow:0 0 8px rgba(255,90,70,.4)}
.combo{
  position:absolute;right:10px;bottom:8px;z-index:4;pointer-events:none;
  padding:3px 10px;border-radius:6px;font-size:12px;font-weight:700;letter-spacing:.04em;
  color:#ffd76a;background:rgba(8,14,24,.7);border:1px solid rgba(242,211,137,.4);
  opacity:0;transform:translateY(4px);transition:opacity .18s,transform .18s;
}
.combo.show{opacity:1;transform:none}
.combo b{font-size:16px;color:#fff;margin-left:2px}
.combo.pop{animation:comboPop .3s ease-out}
@keyframes comboPop{0%{transform:scale(.82)}60%{transform:scale(1.08)}100%{transform:scale(1)}}
.feed{position:absolute;left:10px;top:32px;z-index:4;display:flex;flex-direction:column;gap:4px;pointer-events:none;max-width:72%}
.feed-item{
  display:flex;align-items:center;gap:5px;padding:3px 8px;border-radius:6px;font-size:11px;
  background:rgba(8,14,24,.8);border:1px solid rgba(201,169,89,.32);color:var(--ink);
  animation:feedIn .26s cubic-bezier(.22,1,.36,1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.feed-item b{color:var(--gold-bright);font-weight:700}
.feed-item .elem-img{width:13px;height:13px;flex:none}
.feed-tag{margin-left:2px;color:#ffb3a3;font-size:10px}
.feed-item.sys{color:var(--ink-dim);border-color:rgba(255,255,255,.14);font-size:10px}
@keyframes feedIn{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:none}}
.battle-controls{grid-area:ctl;display:flex;justify-content:center;gap:10px;flex-wrap:wrap}
/* 技能栏 */
.skillbar{
  display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;
  background:linear-gradient(180deg,rgba(18,34,56,.9),rgba(11,20,32,.9));border:1px solid var(--line-dim);
  border-radius:10px;padding:8px 18px;
}
.sb-sel{display:flex;align-items:center;gap:9px;min-width:168px;padding:0 4px}
.sb-avatar{width:38px;height:38px;border-radius:50%;object-fit:cover;border:2px solid var(--gold)}
.sb-name{font-size:14px;font-weight:700}
.sb-elem{font-size:10px;color:var(--ink-dim);margin-top:1px}
.sb-btns{display:flex;gap:8px;flex-wrap:wrap}
.sb-btn{
  position:relative;min-width:136px;min-height:44px;border-radius:8px;padding:6px 12px 6px 36px;
  display:flex;align-items:center;gap:6px;border:1px solid var(--line-dim);
  background:linear-gradient(180deg,rgba(18,34,56,.9),rgba(11,20,32,.9));color:var(--ink);font-size:13px;
  transition:border-color .15s,box-shadow .15s;
}
.sb-btn.e{border-color:var(--ec,#c9a959);background:linear-gradient(180deg,rgba(24,38,60,.95),rgba(12,20,34,.95))}
.sb-btn.q{border-color:rgba(242,211,137,.75);background:linear-gradient(180deg,rgba(36,32,20,.95),rgba(16,14,9,.95))}
.sb-btn:hover{border-color:var(--gold);color:var(--gold-bright);box-shadow:0 0 10px rgba(201,169,89,.25)}
.sb-btn:disabled{opacity:.55;cursor:not-allowed;box-shadow:none}
.sb-key{
  position:absolute;left:6px;top:50%;transform:translateY(-50%);
  width:22px;height:22px;border-radius:6px;display:flex;align-items:center;justify-content:center;
  font-size:12px;font-weight:700;background:var(--ec,#c9a959)26;border:1px solid var(--line);color:var(--ek,#ffd76a);
}
.sb-btn.q .sb-key{background:rgba(242,211,137,.2);color:#ffe9a8}
.sb-cd{
  position:absolute;inset:0;border-radius:7px;display:flex;align-items:center;justify-content:center;
  background:rgba(8,14,24,.74);color:#fff;font-size:13px;font-weight:700;opacity:0;transition:opacity .15s;
}
.sb-btn.cooling .sb-cd{opacity:1}
.sb-note{font-size:10px;color:var(--ink-dim);line-height:1.2;text-align:right}
.sb-btn.q.ready{border-color:var(--gold-bright);color:var(--gold-bright);animation:pulseQ 1.6s ease-in-out infinite}
@keyframes pulseQ{0%,100%{box-shadow:0 0 8px rgba(242,211,137,.35)}50%{box-shadow:0 0 18px rgba(242,211,137,.7)}}
.ctl{
  min-height:44px;padding:0 20px;border-radius:8px;font-size:13px;letter-spacing:.08em;color:var(--ink);
  background:linear-gradient(180deg,rgba(18,34,56,.9),rgba(11,20,32,.9));border:1px solid var(--line-dim);font-weight:500;
}
.ctl:hover{border-color:var(--line);color:var(--gold-bright)}
.ctl.on{border-color:var(--gold);color:var(--gold-bright)}

/* ===== 视图3：结算 ===== */
#view-result{justify-content:flex-start;align-items:center;padding:20px;overflow-y:auto}
.result-card{
  width:min(540px,94%);margin:auto;text-align:center;background:linear-gradient(180deg,rgba(18,34,56,.95),rgba(11,20,32,.97));
  border:1px solid var(--line);border-radius:16px;padding:32px 26px 26px;box-shadow:0 18px 50px rgba(0,0,0,.55);
}
.result-eyebrow{font-size:12px;letter-spacing:.3em;color:var(--ink-dim)}
.result-name{font-size:clamp(28px,6vw,42px);font-weight:900;margin-top:6px;text-shadow:0 0 20px rgba(242,211,137,.45)}
.result-name.red{color:#ff8a72;text-shadow:0 0 22px rgba(255,120,90,.5)}
.result-name.blue{color:#7ab6f5;text-shadow:0 0 22px rgba(110,170,255,.5)}
.result-title{font-size:14px;color:var(--ink-dim);margin-top:2px;letter-spacing:.06em}
.result-avatar{
  width:clamp(110px,22vw,160px);height:clamp(110px,22vw,160px);border-radius:50%;object-fit:cover;margin:18px auto 4px;
  border:3px solid var(--gold);box-shadow:0 0 0 6px rgba(201,169,89,.18),0 16px 40px rgba(0,0,0,.55);
  animation:champ 2.4s ease-in-out infinite;
}
@keyframes champ{0%,100%{box-shadow:0 0 0 6px rgba(201,169,89,.18),0 16px 40px rgba(0,0,0,.55)}50%{box-shadow:0 0 0 12px rgba(201,169,89,.32),0 16px 40px rgba(0,0,0,.55)}}
.result-elem{display:flex;align-items:center;justify-content:center;gap:6px;font-size:12px;color:var(--ink-dim)}
.result-elem svg,.result-elem .elem-img{width:22px;height:22px}
.result-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:20px 0 6px}
.stat{border:1px solid var(--line-dim);border-radius:8px;padding:10px 4px;background:rgba(201,169,89,.05)}
.stat-num{font-size:19px;font-weight:700;color:var(--gold-bright);font-variant-numeric:tabular-nums}
.result-mvp{margin-top:10px;font-size:13px;color:var(--gold-bright);letter-spacing:.05em}
.result-rxn{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin:12px 0 4px}
.rxn-chip{border:1px solid var(--line-dim);border-radius:6px;padding:4px 10px;font-size:12px;color:var(--ink-dim);background:rgba(255,255,255,.03)}
.rxn-chip b{color:var(--gold-bright)}
.result-highlight{margin:10px 0 2px;font-size:12px;color:var(--gold);line-height:1.65;letter-spacing:.02em}
.result-highlight b{color:var(--gold-bright);font-weight:700}
.result-detail{margin:6px auto 0;width:100%;max-height:clamp(170px,26vh,244px);overflow-y:auto;border:1px solid var(--line-dim);border-radius:8px;background:rgba(0,0,0,.18)}
.rd-row{display:flex;align-items:center;gap:8px;padding:5px 10px;font-size:12px;color:var(--ink-dim);border-bottom:1px solid rgba(255,255,255,.05)}
.rd-row:last-child{border-bottom:none}
.rd-row svg{width:16px;height:16px;flex:none}
.rd-name{width:6.5em;color:var(--ink);text-align:left}
.rd-num{flex:1;text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.rd-num.kill{color:var(--gold-bright)}
.stat-label{font-size:11px;color:var(--ink-dim);margin-top:2px}
.result-actions{display:flex;gap:12px;justify-content:center;margin-top:18px}

/* ===== 响应式 ===== */
@media (max-width:900px){
  .teams-wrap{grid-template-columns:1fr}
}
@media (max-width:760px){
  .team-slots{grid-template-columns:1fr;gap:6px}
  .slot:not(.filled){min-height:64px}
  .field-rows{grid-template-columns:1fr;gap:8px}
  /* 选人页：底部按钮不换行会把整页撑宽，导致面板被裁切 */
  .squad-actions{flex-wrap:wrap;gap:10px;margin-top:12px}
  .squad-actions .btn{flex:1 1 calc(50% - 10px);min-width:0;padding:0 10px;font-size:14px}
  /* 战斗页：红蓝 HUD 一行、竞技场吃掉剩余高度、技能栏与操作栏各占一整行 */
  #view-battle.active{grid-template-columns:1fr 1fr;grid-template-rows:auto minmax(220px,1fr) auto auto;grid-template-areas:"red blue" "arena arena" "bar bar" "ctl ctl"}
  .hud-card{min-width:0;width:100%;padding:4px 7px;gap:6px}
  .hud-avatar{width:22px;height:22px;border-width:1px}
  .hud-name{font-size:10px}
  .hud-stats{font-size:8px;margin-top:0}
  .hud-bar{height:4px;margin-top:2px}
  .hud-ebar{height:3px;margin-top:2px}
  .hud-en{display:none}
  .hud-row{gap:4px}
  .team-label{font-size:11px;padding:2px 10px}
  .team-stats{display:none}
  .skillbar{gap:6px;padding:6px 8px;justify-content:center}
  .sb-sel{min-width:0;flex:0 1 auto;gap:6px}
  .sb-avatar{width:28px;height:28px}
  .sb-name{font-size:12px}
  .sb-btns{flex:1 1 auto;justify-content:center}
  .sb-btn{min-width:0;flex:1 1 40%;padding:6px 8px 6px 30px}
  .sb-note{flex-basis:100%;text-align:center;font-size:9px}
  .battle-controls{gap:6px}
  .battle-controls .ctl{flex:1 1 30%;min-width:0;padding:0 8px;font-size:12px}
  .tug{width:94%;top:4px;font-size:10px;gap:5px}
  .tug-bar{height:7px}
  .feed{top:22px;left:6px;max-width:88%}
  .feed-item{font-size:10px;padding:2px 6px}
  .battle-clock{left:6px;bottom:6px;font-size:10px;padding:1px 6px}
  .combo{right:6px;bottom:6px;font-size:10px;padding:2px 7px}
  .combo b{font-size:13px}
  .result-stats{grid-template-columns:repeat(2,1fr)}
  .result-elem{flex-wrap:wrap;row-gap:4px}
  .result-elem .result-mvp{flex-basis:100%;margin-top:2px}
  .result-detail{max-height:150px}
  .rd-row{gap:6px;padding:5px 8px;font-size:11px}
  .rd-name{width:4.6em}
  .rd-num{font-size:11px}
  .result-card{padding:24px 18px 20px}
  #view-battle{padding:8px;overflow-y:auto}
  .pick-val{min-width:44px}
}
@media (max-width:420px){
  .sb-note{display:none}
}
@media (max-width:560px){
  .roster{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
}
@media (max-height:640px){
  .team-stats{display:none}
}
@media (max-width:380px){
  .btn{padding:0 18px;font-size:13px}
  .pick-row label{width:1.8em}
}
@media (prefers-reduced-motion:reduce){
  .result-avatar{animation:none}
}
