  // —— 雷电将军 雷（E 全队附雷 / Q 按大招数增伤） ——
  raidenE(f){
    for(const o of this.fighters){
      if(o.dead||o.team!==f.team) continue;
      o.teamElectro={t:8};
    }
    this.fx('shock', {x:f.x,y:f.y,r:f.r+6,life:0.6,vr:360,color:'#e7c6ff'});
    this.fx('text', {x:f.x,y:f.y-f.r-10,str:'雷罚恶曜之眼·全队附雷',crit:false,life:1.0,color:'#e7c6ff'});
  }
  raidenQ(f){
    // 已释放大招数（不含本次）→ 每多一个 ×0.4，封顶 4.0 倍；释放后队伍计数清零
    const n=Math.max(0,this.qCount[f.team]-1);
    const mult=Math.min(4.0,2.0+n*0.4);
    this.fireProj(f,this.nearestEnemy(f),430,mult,{r:12,pierce:true,life:1.6});
    this.qCount[f.team]=0;
    this.fx('shock', {x:f.x,y:f.y,r:f.r,life:0.5,vr:320,color:'#e7c6ff'});
    this.fx('text', {x:f.x,y:f.y-f.r-10,str:'无想的一刀 ×'+(n+1),crit:false,life:1.2,color:'#e7c6ff'});
  }

