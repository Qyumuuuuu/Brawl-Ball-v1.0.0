function inTeam(id,team){ return team.some(s=>s.roster.id===id); }
function removeFrom(team,id){ const i=team.findIndex(s=>s.roster.id===id); if(i>=0)team.splice(i,1); }
/* 入队时用 BALANCE 里的平衡值作为初始血量/攻击，滑块显示什么，实战就是什么 */
function slotOf(r){
  const b=BALANCE[r.id]||{};
  return {roster:r, hp:b.hp||r.hp, atk:b.atk||r.atk};
}

function cyclePick(id){
  const r=ROSTER.find(x=>x.id===id);
  if(inTeam(id,teamRed)){
    const prev=teamRed.find(s=>s.roster.id===id);
    removeFrom(teamRed,id);
    if(teamBlue.length<TEAM_SIZE) teamBlue.push(prev?{...prev}:slotOf(r));   // 换队时保留已调好的血量/攻击
    else toast('蓝队已满，'+r.name+' 已移出队伍');
  }else if(inTeam(id,teamBlue)){
    removeFrom(teamBlue,id);
  }else{
    if(teamRed.length<TEAM_SIZE) teamRed.push(slotOf(r));
    else if(teamBlue.length<TEAM_SIZE) teamBlue.push(slotOf(r));
    else toast('两队都已满员');
  }
  renderRoster();
}

