function getCrop(id){
  const c=avatarCrops[id];
  return (c&&isFinite(c.scale)&&isFinite(c.ox)&&isFinite(c.oy))?c:defaultCrop(id);
}
/* 统一脸部特写绘制：圆形 cx,cy 半径 d 内，按 crop{scale,ox,oy} 截取人物脸部 */
function drawFace(ctx,img,cx,cy,d,crop){
  const iw=img.naturalWidth, ih=img.naturalHeight;
  const s=(crop.scale*d)/Math.min(iw,ih), dw=iw*s, dh=ih*s;
  ctx.drawImage(img,cx-dw*crop.ox,cy-dh*crop.oy,dw,dh);
}
/* canvas 头像：元素圆底 + crop 脸部特写 / 缺图首字兜底 */
function paintAvatar(canvas,id,name,elem,crop){
  const g=canvas.getContext('2d'), S=canvas.width;
  g.clearRect(0,0,S,S);
  const cx=S/2, cy=S/2, d=S/2-1;
  g.save();
  g.beginPath(); g.arc(cx,cy,d,0,Math.PI*2); g.clip();
  const img=avatarImgs[id];
  if(img&&img.complete&&img.naturalWidth>0){
    g.fillStyle='#0b1420'; g.fill();      // 裁剪窗口越界时不要露出透明缺口
    drawFace(g,img,cx,cy,d,crop);
  }else{
    g.fillStyle=ELEM[elem].c; g.fill();
    g.fillStyle='#fff';
    g.font='900 '+Math.round(d*0.55)+'px "Noto Sans SC",sans-serif';
    g.textAlign='center'; g.textBaseline='middle';
    g.fillText(fbChars(name),cx,cy+1);
  }
  g.restore();
}
function paintAllStaticAvatars(){
