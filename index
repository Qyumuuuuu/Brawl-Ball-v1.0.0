  eliminate(target,attacker){
    target.dead=true; target.hp=0;
    if(attacker&&!attacker.dead) attacker.kills=(attacker.kills||0)+1;
    // 死亡后清除身上的元素附着与个人增益状态，避免尸体残留特效
    target.attached={elem:null,t:0};
    target.dot={elem:null,dps:0,t:0,src:null};
    target.vuln={mult:1,t:0};
    target.shield={t:0,val:0};
    target.boost={mult:1,t:0};
    if(target.stun) target.stun.t=0;
    if(target.mit) target.mit.t=0;
    if(target.gateBuff) target.gateBuff.t=0;
    target.flash=0; target.hitKick=0;
    playKill();
    // 击杀大爆炸：元素色双冲击环 + 白热内环 + 星芒碎片 + 屏幕震动
    const e=ELEM[target.elem];
    this.shake=Math.max(this.shake,0.28);
    for(let i=0;i<38;i++){
      const a=Math.random()*Math.PI*2, sp=70+Math.random()*200;
      this.fx('particle', {x:target.x,y:target.y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:0.7+Math.random()*0.5,r:2.5+Math.random()*3.5,color:Math.random()<0.7?e.c:'#ffffff'});
    }
    for(let i=0;i<14;i++){
      const a=Math.random()*Math.PI*2, sp=140+Math.random()*240;
      this.fx('particle', {type:'spark',x:target.x,y:target.y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:0.4,maxLife:0.4,r:2.5+Math.random()*2,color:Math.random()<0.5?'#fff7e0':'#ffd76a'});
    }
    this.fx('shock', {x:target.x,y:target.y,r:target.r,life:0.55,vr:300,color:e.glow});
    this.fx('shock', {x:target.x,y:target.y,r:target.r*0.5,life:0.4,vr:520,color:'#ffffff'});
    // 金色击杀飘字
    this.fx('text', {x:target.x,y:target.y-target.r-40,str:target.name+' 被击杀！',rxn:true,color:'#ffd76a',glow:'#ffd76a',life:1.4,maxLife:1.4});
    const killer=attacker||{name:'场地',elem:target.elem};
    if(!this.firstBlood) this.firstBlood={t:this.t,killer:killer.name,victim:target.name,rxn:target.lastRxn||null};
    const feedTag=target.lastRxn?'<span class="feed-tag">'+target.lastRxn+'</span>':'';
    this.addFeed(elemIconSvg(killer.elem)+'<b>'+killer.name+'</b> 击败 <b>'+target.name+'</b>'+feedTag,'kill');
    banner(target.name+' 被 '+killer.name+' 击杀！','kill');
    // 胜负判定：任一队全员淘汰
    const redAlive=this.fighters.filter(f=>!f.dead&&f.team==='red').length;
    const blueAlive=this.fighters.filter(f=>!f.dead&&f.team==='blue').length;
    const final=(this.status==='running'&&(redAlive===0||blueAlive===0));
    this.focusCamera(target.x,target.y,final?1.2:1.05,final?2.2:0.8);
    if(final){
      this.status='over';
      this.slowmo=1.8;   // 终局慢镜头，让最后的爆炸多留一会儿
      this.finishTimer=setTimeout(()=>this.finish(redAlive>0?'red':blueAlive>0?'blue':null),2200);
    }
  }

