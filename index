  }

  updateHud(){
    for(const r of this.hudRefs){
      const f=r.f, hp=Math.max(f.hp,0);
      const ratio=Math.max(0,Math.min(1,hp/f.maxHp));
      const hpTxt=Math.ceil(hp);
      if(r.hpTxt!==hpTxt){ r.hpTxt=hpTxt; r.hp.textContent=hpTxt; }
      const fillPct=ratio*100;
      if(r._fillPct===null||Math.abs(fillPct-r._fillPct)>0.5){
        r._fillPct=fillPct; r.fill.style.width=fillPct+'%';
      }
      const cls=ratio>0.5?'ok':ratio>0.25?'warn':'low';
      if(r.hpCls!==cls){
        r.hpCls=cls;
        r.fill.style.background=cls==='ok'?TEAM[f.team].c:cls==='warn'?'#f0a832':'#e85d3a';
      }
      const ghostPct=Math.min(f.ghostHp,f.maxHp)/f.maxHp*100;
      if(r._ghostPct===null||Math.abs(ghostPct-r._ghostPct)>0.5){
        r._ghostPct=ghostPct; r.ghost.style.width=ghostPct+'%';
      }
      const healing=f.pendingHeal>0;
      if(r.ghostHeal!==healing){ r.ghostHeal=healing; r.ghost.style.background=healing?'rgba(110,255,150,.55)':'rgba(255,255,255,.35)'; }
      r.card.classList.toggle('dead',f.dead);
      r.card.classList.toggle('selected',this.selectedId===f.id&&!f.dead);
      if(r.enTxt!==f.energy){ r.enTxt=f.energy; r.en.textContent=f.energy; }
      const enPct=f.energy/ENERGY_MAX*100;
      if(r._enPct===null||Math.abs(enPct-r._enPct)>0.5){
        r._enPct=enPct; r.efill.style.width=enPct+'%';
      }
      const full=f.energy>=ENERGY_MAX;
      if(r.full!==full){ r.full=full; r.enWrap.classList.toggle('full',full); }
    }
    this.updateTeamStats();
    this.updateTug();
    this.updateClock();
    this.updateSkillbar();
  }

  /* 两侧 HUD 下方的队伍汇总 */
  updateTeamStats(){
    for(const team of ['red','blue']){
      const s=this.teamStats[team];
      if(!s||!s.dmg) continue;
      let dmg=0,kills=0,taken=0,alive=0;
      for(const f of this.fighters){
        if(f.team!==team) continue;
        dmg+=f.dmgDealt; kills+=f.kills||0; taken+=f.dmgTaken;
        if(!f.dead) alive++;
      }
      dmg=Math.round(dmg); kills=Math.round(kills); taken=Math.round(taken);
      const aTxt=alive+'/'+TEAM_SIZE;
      if(s._dmg!==dmg){ s._dmg=dmg; s.dmg.textContent=dmg.toLocaleString(); }
      if(s._kills!==kills){ s._kills=kills; s.kills.textContent=kills; }
      if(s._taken!==taken){ s._taken=taken; s.taken.textContent=taken.toLocaleString(); }
      if(s._alive!==aTxt){ s._alive=aTxt; s.alive.textContent=aTxt; }
    }
  }

  /* 顶部团队拔河条：按两队剩余总血量比例 */
  updateTug(){
    let rh=0,bh=0,ra=0,ba=0;
    for(const f of this.fighters){
      if(f.dead) continue;
      if(f.team==='red'){ rh+=Math.max(0,f.hp); ra++; }
      else{ bh+=Math.max(0,f.hp); ba++; }
    }
    const total=rh+bh, rp=total>0?rh/total*100:50;
    if(this._tugPct===null||Math.abs(rp-this._tugPct)>0.5){
      this._tugPct=rp;
      tugRedEl.style.width=rp+'%';
      tugBlueEl.style.width=(100-rp)+'%';
    }
    const rTxt='红队 '+ra, bTxt=ba+' 蓝队';
    if(this._tugR!==rTxt){ this._tugR=rTxt; tugRedName.textContent=rTxt; }
    if(this._tugB!==bTxt){ this._tugB=bTxt; tugBlueName.textContent=bTxt; }
  }

  /* 战斗计时：常规 → 缩圈 → 决胜 */
  updateClock(){
    const sec=Math.max(0,Math.floor(this.t));
    if(this._clockSec===sec) return;
    this._clockSec=sec;
    const mm=Math.floor(sec/60), ss=String(sec%60).padStart(2,'0');
    const phase=this.t>=ZONE_END?'决胜':(this.t>=ZONE_START?'缩圈':'');
    clockEl.textContent=(phase?phase+' ':'')+mm+':'+ss;
    clockEl.classList.toggle('shrink',this.t>=ZONE_START);
  }

  /* 缩圈表现：场外压暗 + 发光边界 */
  drawZone(){
    const z=this.zone, w=this.fieldW, h=this.fieldH;
    if(z.w>=w-0.5) return;
    const pulse=0.5+0.5*Math.sin(this.t*4);
    ctx.save();
    ctx.fillStyle='rgba(5,9,16,.66)';
    ctx.fillRect(0,0,w,z.y);
    ctx.fillRect(0,z.y+z.h,w,h-z.y-z.h);
    ctx.fillRect(0,z.y,z.x,z.h);
    ctx.fillRect(z.x+z.w,z.y,w-z.x-z.w,z.h);
    ctx.strokeStyle='rgba(255,106,82,'+(0.55+0.35*pulse).toFixed(2)+')';
    ctx.lineWidth=3; ctx.shadowColor='#ff6a52'; ctx.shadowBlur=18;
    ctx.strokeRect(z.x,z.y,z.w,z.h);
    ctx.shadowBlur=0; ctx.setLineDash([14,10]); ctx.lineWidth=1.5;
    ctx.strokeStyle='rgba(255,190,170,.55)';
    ctx.strokeRect(z.x+8,z.y+8,z.w-16,z.h-16);
    ctx.restore();
  }

  updateSkillbar(){
    const f=this.fighters.find(x=>x.id===this.selectedId)||null;
    const eBtn=$('#btn-skill-e'), qBtn=$('#btn-skill-q');
    const sbImg=$('#sb-avatar');
    // 头像只在选中角色变化时重绘（此前每帧都重绘一次）
    const sbKey=f&&!f.dead?f.id:'';
    if(this._sbKey!==sbKey){
      this._sbKey=sbKey;
      if(sbKey) paintAvatar(sbImg,f.id,f.name,f.elem,getCrop(f.id));
      else{ const g=sbImg.getContext('2d'); g.clearRect(0,0,sbImg.width,sbImg.height); }
    }
    const nameTxt=f?f.name+(f.dead?'（已阵亡）':''):'未选中';
    if(this._sbName!==nameTxt){ this._sbName=nameTxt; $('#sb-name').textContent=nameTxt; }
    const elemHtml=f&&!f.dead?elemIconSvg(f.elem)+' '+ELEM_CN[f.elem]+'元素':'';
    if(this._sbElem!==elemHtml){ this._sbElem=elemHtml; $('#sb-elem').innerHTML=elemHtml; }
    const noteTxt=this.skillsOn?'点击上方头像选择角色 · 按 E / Q 施放':'技能总开关已关闭 · 点下方「技能 关」开启';
    if(this._sbNote!==noteTxt){ this._sbNote=noteTxt; $('#sb-note').textContent=noteTxt; }
    if(!f||f.dead){
      $('#sb-e-name').textContent='元素战技';
      $('#sb-q-name').textContent='元素爆发';
      $('#sb-e-cd').textContent=''; $('#sb-q-cd').textContent='';
      eBtn.disabled=true; qBtn.disabled=true;
      eBtn.classList.remove('cooling'); qBtn.classList.remove('cooling');
      eBtn.style.setProperty('--ec','#c9a959'); eBtn.style.setProperty('--ek','#ffd76a');
      const ekey=eBtn.querySelector('.sb-key');
      if(ekey){ ekey.style.background='rgba(201,169,89,.18)'; ekey.style.color='#ffd76a'; }
      return;
    }
    const sk=SKILLS[f.id];
    $('#sb-e-name').textContent=sk.e.name;
    $('#sb-q-name').textContent=sk.q.name;
    // E 按钮跟随选中角色的元素色
    const ec=ELEM[f.elem].c;
    eBtn.style.setProperty('--ec',ec);
    eBtn.style.setProperty('--ek',ELEM[f.elem].glow);
    const ekey=eBtn.querySelector('.sb-key');
    if(ekey){ ekey.style.background=ec+'26'; ekey.style.color=ELEM[f.elem].glow; }
    const running=this.status==='running';
    eBtn.disabled=!running||!this.skillsOn||f.skillCd.e>0;
    eBtn.classList.toggle('cooling',f.skillCd.e>0);
    $('#sb-e-cd').textContent=f.skillCd.e>0?Math.ceil(f.skillCd.e)+'s':'';
    const qReady=f.energy>=ENERGY_MAX&&f.skillCd.q<=0;
    qBtn.disabled=!running||!this.skillsOn||!qReady;
    qBtn.classList.toggle('cooling',f.skillCd.q>0);
    qBtn.classList.toggle('ready',qReady);
    $('#sb-q-cd').textContent=f.skillCd.q>0?Math.ceil(f.skillCd.q)+'s':f.energy+' / '+ENERGY_MAX;
  }

  shock(x1,y1,x2,y2){
    this.fx('shock', {x:(x1+x2)/2, y:(y1+y2)/2, r:8, life:0.35, vr:240, color:'#e8e2d4'});
  }

  // 碰撞命中特效：挥击弧光 + 星芒爆裂 + 命中白闪 + 冲击环
  hitFx(ax,ay,bx,by,nx,ny){
    const mx=(ax+bx)/2, my=(ay+by)/2;
    const ang=Math.atan2(ny,nx);
    // 双方各两道挥击弧光（主弧亮白 + 内弧金）
    this.fx('particle', {type:'slash',x:mx,y:my,vx:0,vy:0,ang:ang,len:52,life:0.22,maxLife:0.22,color:'#ffffff'});
    this.fx('particle', {type:'slash',x:mx,y:my,vx:0,vy:0,ang:ang,len:30,life:0.22,maxLife:0.22,color:'#ffe9a8'});
    this.fx('particle', {type:'slash',x:mx,y:my,vx:0,vy:0,ang:ang+Math.PI,len:52,life:0.22,maxLife:0.22,color:'#ffffff'});
    this.fx('particle', {type:'slash',x:mx,y:my,vx:0,vy:0,ang:ang+Math.PI,len:30,life:0.22,maxLife:0.22,color:'#ffe9a8'});
    // 命中点星芒爆裂
    for(let k=0;k<10;k++){
      const aa=Math.random()*Math.PI*2, sp=110+Math.random()*180;
      this.fx('particle', {type:'spark',x:mx,y:my,vx:Math.cos(aa)*sp,vy:Math.sin(aa)*sp,life:0.3,maxLife:0.3,r:2.5+Math.random()*2,color:Math.random()<0.6?'#fff7e0':'#ffd76a'});
    }
    // 命中白闪（短促大环）+ 金色冲击环 + 中性白环
    this.fx('shock', {x:mx,y:my,r:4,life:0.14,vr:540,color:'#ffffff'});
    this.fx('shock', {x:mx,y:my,r:6,life:0.3,vr:340,color:'#ffd76a'});
    this.fx('shock', {x:mx,y:my,r:8,life:0.35,vr:240,color:'#e8e2d4'});
  }

  /* ---------- 绘制 ---------- */
  draw(){
    // 自愈：首次进入战斗时若布局未稳定导致 buffer 停在默认 300×150，
    // 每帧校验 CSS 尺寸与 buffer 是否匹配，错配即重设，避免球体被拉伸变形
    const wrap=canvas.parentElement, dpr=this.dpr;
    const cw=wrap.clientWidth, ch=wrap.clientHeight;
    if(cw&&ch&&(canvas.width!==Math.round(cw*dpr)||canvas.height!==Math.round(ch*dpr))) this.resize();
    ctx.setTransform(this.dpr,0,0,this.dpr,0,0);
    // 场地外
    ctx.fillStyle=this.theme.bg; ctx.fillRect(0,0,this.cw,this.ch);
    ctx.save();
    // 屏幕震动 + 击杀镜头：以屏幕中心为基准缩放/平移
    const sh=this.shake>0?this.shake*10:0;
    const shx=sh?(Math.random()-0.5)*sh:0;
    const shy=sh?(Math.random()-0.5)*sh:0;
    const camZ=this.camZoom||1;
    ctx.translate((this.cw||this.fieldW)/2+shx,(this.ch||this.fieldH)/2+shy);
    ctx.scale(this.scale*camZ,this.scale*camZ);
    ctx.translate(-(this.camX||this.fieldW/2),-(this.camY||this.fieldH/2));
    const w=this.fieldW,h=this.fieldH;
    // 静态背景层：离屏缓存（已含实景图/遮罩/渐变/四角/边界/中心纹章）
    if(this.bgCacheReady) ctx.drawImage(this.bgCache,0,0,w,h);
    // 竞技场内容裁剪：飘字/特效不要溢出到场地外的留白里
    ctx.beginPath(); ctx.rect(0,0,w,h); ctx.clip();
    // 冲击环
    for(const s of this.shocks){
      ctx.save();
      ctx.globalAlpha=s.life/0.55*0.85;
      ctx.strokeStyle=s.color; ctx.lineWidth=3;
      ctx.beginPath(); ctx.arc(s.x,s.y,s.r,0,Math.PI*2); ctx.stroke();
      ctx.restore();
    }
    // 领域（琴Q 蒲公英 / 迪奥娜Q 特调）
    for(const d of this.domains){
      const col=d.type==='jean'?'#a0f0d4':'#d6f4ff';
      ctx.save();
      ctx.globalAlpha=0.2+0.08*Math.sin(this.t*3);
      ctx.fillStyle=col;
      ctx.beginPath(); ctx.arc(d.x,d.y,d.R,0,Math.PI*2); ctx.fill();
      ctx.globalAlpha=0.55;
      ctx.strokeStyle=col; ctx.lineWidth=2; ctx.setLineDash([12,8]);
      ctx.beginPath(); ctx.arc(d.x,d.y,d.R,0,Math.PI*2); ctx.stroke();
      ctx.setLineDash([]);
      ctx.font='13px "Microsoft YaHei",sans-serif'; ctx.textAlign='center';
      ctx.fillStyle=col;
      ctx.fillText(d.type==='jean'?'蒲公英领域':'特调领域',d.x,d.y-d.R-8);
      ctx.restore();
    }
    // 旋风（温迪Q 持续吸附）
    for(const c of this.cyclones){
      ctx.save();
      ctx.globalAlpha=0.12+0.08*Math.sin(this.t*6);
      ctx.fillStyle='#a0f0d4';
      ctx.beginPath(); ctx.arc(c.x,c.y,c.R,0,Math.PI*2); ctx.fill();
      ctx.globalAlpha=0.55;
      for(let k=0;k<3;k++){
        const rr=c.R*(0.4+0.28*k), ph=this.t*6+k*2.1;
        ctx.strokeStyle='#a0f0d4'; ctx.lineWidth=2;
        ctx.beginPath();
        for(let i=0;i<20;i++){
          const aa=ph+i*0.35, rad=rr*(1+0.25*Math.sin(aa*3));
          const px=c.x+Math.cos(aa)*rad, py=c.y+Math.sin(aa)*rad;
          i?ctx.lineTo(px,py):ctx.moveTo(px,py);
        }
        ctx.stroke();
      }
      ctx.restore();
      // 风眼标记 + 施放者名（标明特效来源）
      ctx.globalAlpha=0.95;
      ctx.strokeStyle='#e8fff6'; ctx.lineWidth=2;
      ctx.beginPath(); ctx.arc(c.x,c.y,11,0,Math.PI*2); ctx.stroke();
      ctx.fillStyle='#e8fff6';
      ctx.font='700 12px "Noto Sans SC",sans-serif'; ctx.textAlign='center';
      ctx.fillText((c.owner?c.owner.name+'·':'')+'风神之诗',c.x,c.y+24);
    }
    // 直线波（迪卢克Q 烈焰路径）
    for(const L of this.lines){
      ctx.save();
      const a=Math.atan2(L.vy,L.vx);
      ctx.translate(L.x,L.y); ctx.rotate(a);
      ctx.shadowColor='#ff9a5c'; ctx.shadowBlur=14;
      ctx.fillStyle='rgba(255,150,70,.85)';
      ctx.fillRect(-16,-L.width/2+8,160,L.width-16);
      ctx.shadowBlur=0;
      const grd=ctx.createLinearGradient(0,-L.width/2,0,L.width/2);
      grd.addColorStop(0,'rgba(255,120,60,0)');
      grd.addColorStop(0.5,'rgba(255,200,120,.5)');
      grd.addColorStop(1,'rgba(255,120,60,0)');
      ctx.fillStyle=grd;
      ctx.fillRect(-30,-L.width/2,180,L.width);
      ctx.restore();
    }
    // 屏障（凝光E 璇玑屏）
    for(const g of this.gates){
      ctx.save();
      ctx.globalAlpha=0.22;
      ctx.fillStyle='#f4e3b2';
      ctx.fillRect(g.x-7,-10,14,this.fieldH+20);
      ctx.globalAlpha=0.85;
      ctx.strokeStyle='#f4e3b2'; ctx.lineWidth=2.5;
      ctx.beginPath(); ctx.moveTo(g.x,-10); ctx.lineTo(g.x,this.fieldH+10); ctx.stroke();
      ctx.globalAlpha=0.95;
      ctx.font='12px "Microsoft YaHei",sans-serif'; ctx.textAlign='center';
      ctx.fillStyle='#f4e3b2';
      ctx.fillText('璇玑屏',g.x,g.y-12);
      ctx.restore();
    }
    // 球
    for(const f of this.fighters){
      if(f.dead&&f.alpha<=0) continue;
      const t=TEAM[f.team];
      // 受击抖动：hitKick 期间球体在正弦波上轻微震动
      const hk=f.hitKick>0?Math.sin(f.hitKick*46)*f.hitKick*24:0;
      const ox=f.x+hk, oy=f.y+(f.hitKick>0?Math.cos(f.hitKick*40)*f.hitKick*14:0);
      ctx.save();
      ctx.globalAlpha=Math.max(f.alpha,0);
      if(f.dead) ctx.filter='grayscale(1) brightness(0.85)'; // 阵亡头像变灰
      ctx.fillStyle='rgba(0,0,0,.35)';
      ctx.beginPath(); ctx.ellipse(ox,oy+f.r*0.92,f.r*0.9,f.r*0.28,0,0,Math.PI*2); ctx.fill();
      // 队伍色外环
      ctx.shadowColor=t.glow; ctx.shadowBlur=16;
      ctx.strokeStyle=t.c; ctx.lineWidth=4;
      ctx.beginPath(); ctx.arc(ox,oy,f.r,0,Math.PI*2); ctx.stroke();
      ctx.shadowBlur=0;
      // 元素内环
      const e=ELEM[f.elem];
      ctx.strokeStyle=e.c; ctx.lineWidth=f.boost&&f.boost.t>0?3.5:1.5;
      ctx.beginPath(); ctx.arc(ox,oy,f.r-4.5,0,Math.PI*2); ctx.stroke();
      // 头像（脸部特写，按该角色保存的 crop 绘制）
      ctx.beginPath(); ctx.arc(ox,oy,f.r-7,0,Math.PI*2); ctx.clip();
      const img=avatarImgs[f.id];
      if(img&&img.complete&&img.naturalWidth>0){
        ctx.fillStyle='#0b1420'; ctx.fill();   // 裁剪窗口越界时不露透明缺口
        drawFace(ctx,img,ox,oy,f.r-7,getCrop(f.id));
      }else{
        // 无图/未加载：元素色圆底 + 角色名首字
        ctx.fillStyle=e.c; ctx.fill();
        ctx.fillStyle='#fff';
        ctx.font='900 '+(f.r*0.5)+'px "Noto Sans SC",sans-serif';
        ctx.textAlign='center'; ctx.textBaseline='middle';
        ctx.fillText(fbChars(f.name),ox,oy+1);
      }
      if(f.flash>0){
        ctx.shadowColor='#ff4d4d'; ctx.shadowBlur=26;
        ctx.globalAlpha=Math.min(f.flash/0.22,1)*0.95;
        ctx.fillStyle='#ff4d4d'; ctx.beginPath(); ctx.arc(ox,oy,f.r-4,0,Math.PI*2); ctx.fill();
        ctx.shadowBlur=0;
      }
      ctx.restore();
      // 元素附着（醒目发光环 + 内侧元素描边 + 旋转元素光点）
      if(f.attached.elem){
        const ae=ELEM[f.attached.elem];
        const at=Math.min(f.attached.t/ATTACH_T,1); // 剩余附着时间比例
        ctx.save();
        // 外圈：加粗虚线环 + 元素色辉光
        ctx.shadowColor=ae.c; ctx.shadowBlur=14;
        ctx.strokeStyle=ae.c; ctx.lineWidth=3.5;
        ctx.globalAlpha=0.35+0.6*at;
        ctx.setLineDash([7,5]);
        ctx.beginPath(); ctx.arc(f.x,f.y,f.r+7,0,Math.PI*2); ctx.stroke();
        ctx.shadowBlur=0;
        // 内侧：球边缘一圈元素色描边
        ctx.setLineDash([]);
        ctx.lineWidth=4.5; ctx.globalAlpha=0.45*at;
        ctx.beginPath(); ctx.arc(f.x,f.y,f.r-2.5,0,Math.PI*2); ctx.stroke();
        // 环上旋转元素光点（提示元素类型）
        ctx.globalAlpha=0.85*at;
        ctx.fillStyle=ae.c;
        for(let k=0;k<3;k++){
          const aa=this.t*2.4+k*Math.PI*2/3;
          ctx.beginPath(); ctx.arc(f.x+Math.cos(aa)*(f.r+7),f.y+Math.sin(aa)*(f.r+7),3.5,0,Math.PI*2); ctx.fill();
        }
        ctx.restore();
      }
      // 定身：石化（灰石环）/ 冻结（冰蓝环 + 霜面）
      if(f.stun&&f.stun.t>0){
        const frozen=f.stun.kind==='freeze';
        const stCol=frozen?'#bfefff':'#c9b99a';
        ctx.save();
        ctx.strokeStyle=stCol; ctx.lineWidth=3;
        if(frozen) ctx.setLineDash([6,4]);
        ctx.globalAlpha=0.55+0.45*Math.min(1,f.stun.t/FREEZE_T);
        ctx.beginPath(); ctx.arc(f.x,f.y,f.r+3,0,Math.PI*2); ctx.stroke();
        ctx.setLineDash([]);
        ctx.globalAlpha=1;
        if(frozen){
          ctx.fillStyle='rgba(191,239,255,.22)';
          ctx.beginPath(); ctx.arc(f.x,f.y,f.r,0,Math.PI*2); ctx.fill();
        }
        ctx.fillStyle=stCol; ctx.font='11px "Microsoft YaHei",sans-serif'; ctx.textAlign='center';
        ctx.fillText(frozen?'冻结':'石化',f.x,f.y-f.r-14);
        ctx.restore();
      }
      // 结晶护盾（金圈）
      if(f.shield.t>0){
        ctx.save();
        ctx.strokeStyle='rgba(244,227,178,.9)'; ctx.lineWidth=2;
        ctx.beginPath(); ctx.arc(f.x,f.y,f.r+8,0,Math.PI*2); ctx.stroke();
        ctx.restore();
      }
      // 超导易伤（脚下三角）
      if(f.vuln.t>0){
        ctx.save();
        ctx.fillStyle='rgba(214,244,255,.9)';
        ctx.beginPath(); ctx.moveTo(f.x-9,f.y+f.r+15); ctx.lineTo(f.x+9,f.y+f.r+15); ctx.lineTo(f.x,f.y+f.r+25); ctx.closePath(); ctx.fill();
        ctx.restore();
      }
      // 选中角色（金虚线环）
      if(this.selectedId===f.id){
        ctx.save();
        ctx.strokeStyle='#f2d389'; ctx.lineWidth=2.5; ctx.setLineDash([8,5]);
        ctx.globalAlpha=0.95;
        ctx.beginPath(); ctx.arc(f.x,f.y,f.r+13,0,Math.PI*2); ctx.stroke();
        ctx.restore();
      }
      // 名字 + 血条
      ctx.save();
      ctx.font='700 12px "Noto Sans SC",sans-serif';
      ctx.textAlign='center';
      ctx.fillStyle='rgba(0,0,0,.7)';
      const nameW=ctx.measureText(f.name).width;
      ctx.fillRect(f.x-nameW/2-4,f.y-f.r-40,nameW+8,18);
      ctx.fillStyle='#f2ecd9';
      ctx.fillText(f.name,f.x,f.y-f.r-25);
      const bw=f.r*2.1, bx=f.x-bw/2, by=f.y+f.r+8;
      ctx.fillStyle='rgba(0,0,0,.6)';
      ctx.fillRect(bx,by,bw,6);
      const ratio=Math.max(f.hp,0)/f.maxHp;
      const gr=Math.min(f.ghostHp,f.maxHp)/f.maxHp;
      if(gr>ratio+0.004){   // 延迟血量条：画在红条下层（扣血白色 / 回血绿色），半透明避免被误读成满血
        ctx.fillStyle=f.pendingHeal>0?'rgba(110,255,150,.55)':'rgba(255,255,255,.35)';
        ctx.fillRect(bx,by,bw*gr,6);
      }
      ctx.fillStyle=ratio>0.5?t.c:ratio>0.25?'#f0a832':'#e85d3a';
      ctx.fillRect(bx,by,bw*ratio,6);
      ctx.strokeStyle='rgba(201,169,89,.8)'; ctx.lineWidth=1;
      ctx.strokeRect(bx-0.5,by-0.5,bw+1,7);
      // 能量条（金色）
      const eby=by+9;
      ctx.fillStyle='rgba(0,0,0,.55)';
      ctx.fillRect(bx,eby,bw,4);
      ctx.fillStyle=f.energy>=ENERGY_MAX?'#f2d389':'rgba(242,211,137,.8)';
      ctx.fillRect(bx,eby,bw*(f.energy/ENERGY_MAX),4);
      ctx.restore();
    }
    // 投射物
    for(const pr of this.projectiles){
      ctx.save();
      ctx.globalAlpha=Math.min(pr.life/0.5,1);
      ctx.fillStyle=pr.color; ctx.shadowColor=pr.color; ctx.shadowBlur=12;
      ctx.beginPath(); ctx.arc(pr.x,pr.y,pr.r,0,Math.PI*2); ctx.fill();
      const la=Math.atan2(pr.vy,pr.vx);
      ctx.globalAlpha*=0.35;
      ctx.beginPath(); ctx.arc(pr.x-Math.cos(la)*18,pr.y-Math.sin(la)*18,pr.r*0.7,0,Math.PI*2); ctx.fill();
      ctx.restore();
    }
    // 岩结晶小球（金色菱形）+ 草水小球（绿色发光球）
    for(const ore of this.ores){
      ctx.save();
      ctx.globalAlpha=Math.min(ore.t/2,1);
      ctx.translate(ore.x,ore.y); ctx.rotate(this.t*2);
      ctx.fillStyle='#f4e3b2'; ctx.shadowColor='#f4e3b2'; ctx.shadowBlur=10;
      ctx.beginPath(); ctx.moveTo(0,-ore.r*1.4); ctx.lineTo(ore.r*1.4,0); ctx.lineTo(0,ore.r*1.4); ctx.lineTo(-ore.r*1.4,0); ctx.closePath(); ctx.fill();
      ctx.restore();
    }
    for(const pill of this.pills){
      ctx.save();
      ctx.globalAlpha=Math.min(pill.t/2,1);
      ctx.fillStyle='#b8e88a'; ctx.shadowColor='#b8e88a'; ctx.shadowBlur=14;
      ctx.beginPath(); ctx.arc(pill.x,pill.y,pill.r,0,Math.PI*2); ctx.fill();
      ctx.restore();
    }
    // 粒子
    for(const p of this.particles){
      ctx.save();
      ctx.globalAlpha=Math.min(p.life/(p.maxLife||0.7),1);
      if(p.type==='slash'){
        // 挥击弧光：沿攻击方向扫过一道亮弧
        ctx.translate(p.x,p.y); ctx.rotate(p.ang);
        ctx.strokeStyle=p.color; ctx.lineCap='round';
        ctx.lineWidth=1.5+3.5*p.life/(p.maxLife||0.2);
        ctx.beginPath(); ctx.arc(0,0,p.len,0.35,Math.PI-0.35); ctx.stroke();
        ctx.restore(); continue;
      }
      if(p.type==='spark'){
        // 星芒：十字亮线
        ctx.strokeStyle=p.color; ctx.lineWidth=1.6;
        const s=p.r*3.2*(0.5+0.5*p.life/0.28);
        ctx.beginPath(); ctx.moveTo(p.x-s,p.y); ctx.lineTo(p.x+s,p.y);
        ctx.moveTo(p.x,p.y-s); ctx.lineTo(p.x,p.y+s); ctx.stroke();
        ctx.restore(); continue;
      }
      if(p.type==='mist'){
        // 蒸汽/风卷：半透明上升圆
        const pl=p.life/(p.maxLife||0.8);
        ctx.globalAlpha=pl*0.55;
        ctx.fillStyle=p.color;
        ctx.beginPath(); ctx.arc(p.x,p.y,p.r*(0.5+0.5*pl),0,Math.PI*2); ctx.fill();
        ctx.restore(); continue;
      }
      if(p.type==='flame'){
        // 火焰：红橙圆上飘收缩
        const pl=p.life/(p.maxLife||0.7);
        ctx.globalAlpha=pl*0.9;
        ctx.fillStyle=p.color;
        ctx.beginPath(); ctx.arc(p.x,p.y,p.r*pl,0,Math.PI*2); ctx.fill();
        ctx.restore(); continue;
      }
      if(p.type==='snow'){
        // 雪花：十字小雪花
        const pl=p.life/(p.maxLife||0.8);
        ctx.globalAlpha=pl*0.85;
        ctx.strokeStyle=p.color; ctx.lineWidth=1.2;
        const s=p.r;
        ctx.beginPath();
        ctx.moveTo(p.x-s,p.y); ctx.lineTo(p.x+s,p.y);
        ctx.moveTo(p.x,p.y-s); ctx.lineTo(p.x,p.y+s);
        ctx.stroke();
        ctx.restore(); continue;
      }
      if(p.type==='bolt'){
        // 电弧：两点间随机折线闪电
        const pl=p.life/(p.maxLife||0.25);
        ctx.globalAlpha=Math.min(pl,1);
        ctx.strokeStyle=p.color; ctx.lineWidth=1.6+pl*1.6; ctx.lineCap='round'; ctx.lineJoin='round';
        ctx.beginPath(); ctx.moveTo(p.x1,p.y1);
        const segs=5;
        for(let i=1;i<segs;i++){
          const t=i/segs;
          const bx=p.x1+(p.x2-p.x1)*t+(Math.sin(p.seed*37+i*7.13)*pl*14);
          const by=p.y1+(p.y2-p.y1)*t+(Math.cos(p.seed*31+i*5.7)*pl*14);
          ctx.lineTo(bx,by);
        }
        ctx.lineTo(p.x2,p.y2); ctx.stroke();
        ctx.restore(); continue;
      }
      ctx.fillStyle=p.color;
      ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2); ctx.fill();
      ctx.restore();
    }
    // 飘字：纯元素色，缓慢上飘渐隐（无晃动/发光/描边/阴影）
    for(const t of this.texts){
      ctx.save();
      const pr=t.life/(t.maxLife||t.life);   // 剩余比例
      ctx.globalAlpha=pr>0.4?1:(pr/0.4);     // 前 60% 清晰，末段缓慢淡出
      if(t.rxn){
        ctx.font='900 26px "Noto Serif SC",serif';
        ctx.fillStyle=t.color;
      }else if(t.crit){
        ctx.font='900 32px "Noto Serif SC",serif';
        ctx.fillStyle=t.elem?ELEM[t.elem].c:'#ffd76a';
      }else if(t.elem){
        ctx.font='900 24px "Noto Serif SC",serif';
        ctx.fillStyle=ELEM[t.elem].c;
      }else if(t.heal){
        ctx.font='800 17px "Noto Sans SC",sans-serif';
        ctx.fillStyle='#8affb0';
      }else{
        ctx.font='800 16px "Noto Sans SC",sans-serif';
        ctx.fillStyle=t.color||'#ffffff';
      }
      ctx.textAlign='center';
      ctx.fillText(t.str,t.x,t.y);
      ctx.restore();
    }
    this.drawZone();   // 缩圈压暗放在最后，场外特效也一起压暗
    ctx.restore();
  }
}

function banner(str,kind){
  bannerEl.textContent=str;
  bannerEl.className='banner '+(kind||'');
  bannerEl.classList.add('show');
  clearTimeout(banner._t);
  banner._t=setTimeout(()=>bannerEl.classList.remove('show'),2400);
}

/* ================= 结算 ================= */
function renderResult(winTeam,reason){
  const isTimeout=reason==='timeout';
  const stats=game.fighters;
  const sorted=stats.slice().sort((a,b)=>b.dmgDealt-a.dmgDealt);
  const mvp=sorted[0];
  // 大图展示胜方存活者里输出最高的人（没有存活者才退回全队），"输出之王"仍按全场伤害
  let ace=mvp;
  if(winTeam){
    const winAll=stats.filter(f=>f.team===winTeam);
    const winAlive=winAll.filter(f=>!f.dead);
    ace=(winAlive.length?winAlive:winAll).slice().sort((a,b)=>b.dmgDealt-a.dmgDealt)[0]||mvp;
  }
  const killKing=stats.slice().sort((a,b)=>(b.kills||0)-(a.kills||0))[0];
  const tankKing=stats.slice().sort((a,b)=>b.dmgTaken-a.dmgTaken)[0];
  const resCv=$('#res-avatar');
  if(!winTeam){
    $('#res-eyebrow').textContent=isTimeout?'时间到 · 平分秋色':'双双重创';
    $('#res-name').textContent='无人胜出';
    $('#res-name').className='result-name';
    $('#res-title').textContent=isTimeout?'3 分钟战罢，两队势均力敌':'两队同时倒下，角斗场归于沉寂';
    resCv.style.display='none';
    $('#res-elem').innerHTML='<p class="result-mvp">输出之王 '+mvp.name+' · 击杀王 '+killKing.name+' · 承伤王 '+tankKing.name+'</p>';
  }else{
    const t=TEAM[winTeam];
    const alive=stats.filter(f=>!f.dead&&f.team===winTeam);
    $('#res-eyebrow').textContent=isTimeout?'时间到 · 优势获胜':'获胜队伍';
    $('#res-name').textContent=t.name;
    $('#res-name').className='result-name '+winTeam;
    $('#res-title').textContent=(isTimeout?'时间到，':'')+alive.map(f=>f.name).join(' · ')+' 赢得胜利';
    resCv.style.display='';
    paintAvatar(resCv,ace.id,ace.name,ace.elem,getCrop(ace.id));   // 与选人/战斗保持一致的脸部特写
    resCv.setAttribute('aria-label','MVP '+ace.name);
    $('#res-elem').innerHTML=elemIconSvg(ace.elem)+'<span>'+({pyro:'火',hydro:'水',electro:'雷',anemo:'风',geo:'岩',dendro:'草',cryo:'冰'})[ace.elem]+'元素 · MVP '+ace.name+'</span><p class="result-mvp">输出之王 '+mvp.name+' · 击杀王 '+killKing.name+' · 承伤王 '+tankKing.name+'</p>';
  }
  const mins=Math.floor(game.t/60), secs=Math.floor(game.t%60);
  $('#res-stats').innerHTML=
    '<div class="stat"><div class="stat-num">'+(mins?mins+'分':'')+secs+'秒</div><div class="stat-label">战斗时长</div></div>'
    +'<div class="stat"><div class="stat-num">'+game.hits+'</div><div class="stat-label">碰撞次数</div></div>'
    +'<div class="stat"><div class="stat-num">'+game.reactions+'</div><div class="stat-label">元素反应</div></div>'
    +'<div class="stat"><div class="stat-num">'+Math.round(game.totalDmg).toLocaleString()+'</div><div class="stat-label">造成总伤害</div></div>';
  // 反应统计
  const rcs=Object.entries(game.rxnCounts).sort((a,b)=>b[1]-a[1]);
  $('#res-rxn').innerHTML=rcs.length?rcs.map(r=>'<span class="rxn-chip">'+r[0]+' ×<b>'+r[1]+'</b></span>').join(''):'';
  // 本局高光：最大单次伤害 + 首杀
  const hi=[];
  const mh=game.maxHit;
  if(mh&&mh.dmg>0) hi.push('最大单次伤害 <b>'+mh.dmg.toLocaleString()+'</b>（'+mh.src+' → '+mh.target+(mh.rxn?' · '+mh.rxn:'')+'）');
  if(game.firstBlood) hi.push('首杀 <b>'+Math.floor(game.firstBlood.t)+' 秒</b>（'+game.firstBlood.killer+' → '+game.firstBlood.victim+'）');
  if(game.bestCombo>=3){
    const types=Object.entries(game.bestComboTypes||{}).sort((a,b)=>b[1]-a[1]).slice(0,3).map(([k,v])=>k+'×'+v).join(' · ');
    hi.push('元素连携 <b>×'+game.bestCombo+'</b>'+(types?'（'+types+'）':''));
  }
  $('#res-highlight').innerHTML=hi.length?'本局高光：'+hi.join(' · '):'';
  // 角色明细：伤害 / 击杀 / 承伤（按伤害降序）
  $('#res-detail').innerHTML=sorted.map(f=>{
    return '<div class="rd-row">'+elemIconSvg(f.elem)+'<span class="rd-name">'+f.name+'</span>'
      +'<span class="rd-num">伤害 '+Math.round(f.dmgDealt).toLocaleString()+'</span>'
      +'<span class="rd-num kill">击杀 '+(f.kills||0)+'</span>'
      +'<span class="rd-num">承伤 '+Math.round(f.dmgTaken).toLocaleString()+'</span></div>';
  }).join('');
}

/* ================= HUD ================= */
function renderHud(){
  game.hudRefs=[];
  ['red','blue'].forEach(team=>{
    const el=team==='red'?hudRed:hudBlue;
    const cards=game.fighters.filter(f=>f.team===team).map(f=>{
      return '<div class="hud-card '+team+'" data-id="'+f.id+'">'
        +'<canvas class="hud-avatar" width="34" height="34" data-id="'+f.id+'" data-elem="'+f.elem+'" data-name="'+f.name+'"></canvas>'
        +'<div class="hud-main">'
        +'<div class="hud-name">'+f.name+' '+elemIconSvg(f.elem,'elem-ic')+'</div>'
        +'<div class="hud-stats">HP <span data-hp>'+f.maxHp+'</span> / '+f.maxHp+' · ATK '+f.atk+'</div>'
        +'<div class="hud-bar"><div class="hud-ghost" data-ghost></div><div class="hud-fill" data-fill style="width:100%;background:'+TEAM[team].c+'"></div></div>'
        +'<div class="hud-ebar"><div class="hud-fill" data-efill style="width:0%"></div></div>'
        +'<div class="hud-en">能量 <span data-en>0</span>/'+ENERGY_MAX+'</div>'
        +'</div></div>';
    }).join('');
    const statsHtml='<div class="team-stats '+team+'">'
      +'<div class="ts"><span>总伤害</span><b data-ts="dmg">0</b></div>'
      +'<div class="ts"><span>击杀</span><b data-ts="kills">0</b></div>'
      +'<div class="ts"><span>承伤</span><b data-ts="taken">0</b></div>'
      +'<div class="ts"><span>存活</span><b data-ts="alive">4/4</b></div>'
      +'</div>';
    el.innerHTML='<div class="hud-row"><span class="team-label '+team+'">'+TEAM[team].name+'</span>'+cards+statsHtml+'</div>';
    el.querySelectorAll('.hud-avatar').forEach(cv=>paintAvatar(cv,cv.dataset.id,cv.dataset.name,cv.dataset.elem,getCrop(cv.dataset.id)));
    el.querySelectorAll('.hud-card').forEach(card=>{
      const f=game.fighters.find(x=>x.id===card.dataset.id);
      card.addEventListener('click',()=>game.select(card.dataset.id));
      if(!f) return;
      // 缓存节点：每帧 updateHud 不再全表 querySelector
      game.hudRefs.push({
        f, card,
        hp:card.querySelector('[data-hp]'), fill:card.querySelector('[data-fill]'),
        ghost:card.querySelector('[data-ghost]'), en:card.querySelector('[data-en]'),
        efill:card.querySelector('[data-efill]'), enWrap:card.querySelector('.hud-en'),
        hpCls:'', hpTxt:null, ghostHeal:null, full:null, enTxt:null,
        _fillPct:null, _ghostPct:null, _enPct:null   // 血条/能量条宽度脏检查（变化超阈值才写 DOM）
      });
    });
    const stEl=el.querySelector('.team-stats');
    if(stEl){
      game.teamStats[team]={
        dmg:stEl.querySelector('[data-ts="dmg"]'), kills:stEl.querySelector('[data-ts="kills"]'),
        taken:stEl.querySelector('[data-ts="taken"]'), alive:stEl.querySelector('[data-ts="alive"]'),
        _dmg:-1, _kills:-1, _taken:-1, _alive:''
      };
    }
  });
}

/* ================= 开始战斗 ================= */
function syncSkillsBtn(on){
  const b=$('#btn-skills');
  b.textContent='技能 '+(on?'开':'关');
  b.classList.toggle('on',on);
}
function syncTeamPassBtn(){
  const b=$('#btn-team-pass');
  b.textContent='同队穿透 '+(teamPassThrough?'开':'关');
  b.classList.toggle('on',teamPassThrough);
}
function startBattle(){
  if(teamRed.length<TEAM_SIZE||teamBlue.length<TEAM_SIZE){ toast('两队都需要选满 4 名角色'); return; }
  if(loadedCount<totalCount){ toast('素材仍在加载，请稍候'); return; }
  ensureAudio();
  sound.on=true;
  $('#btn-sound').textContent='音效 开'; $('#btn-sound').classList.add('on');
  $('#btn-pause').textContent='暂停';
  $('#btn-speed').textContent='速度 1x'; $('#btn-speed').classList.remove('on');
  syncSkillsBtn(skillsAuto);
  syncTeamPassBtn();
  if(feedEl) feedEl.innerHTML='';
  if(comboEl){ comboEl.classList.remove('show'); comboEl.classList.remove('pop'); comboEl.innerHTML=''; }
  if(clockEl){ clockEl.textContent='0:00'; clockEl.classList.remove('shrink'); }
  if(tugRedEl) tugRedEl.style.width='50%';
  if(tugBlueEl) tugBlueEl.style.width='50%';
  if(tugRedName) tugRedName.textContent='红队 4';
  if(tugBlueName) tugBlueName.textContent='4 蓝队';
  if(game) game.destroy();
  showView('battle');
  game=new Game();
  renderHud();
  $('#btn-music').textContent='音乐 '+(musicOn?'开':'关'); $('#btn-music').classList.toggle('on',musicOn);
  playThemeMusic(game.themeKey);
  const firstAlive=game.fighters.find(f=>!f.dead);
  if(firstAlive) game.select(firstAlive.id);
}

/* ================= 事件绑定 ================= */
// 首次点击即初始化音频上下文（浏览器要求用户手势后才能出声）
document.addEventListener('pointerdown',()=>ensureAudio(),{once:true});
$('#field-size').addEventListener('input',e=>{ const v=+e.target.value; field.w=v; field.h=v; $('#field-size-val').textContent=v; });
// 场地主题切换（localStorage 持久化）
(function(){
  let cur=lsGet('genshinArenaTheme')||'liyue';
  const btns=document.querySelectorAll('.theme-btn');
  const paint=()=>btns.forEach(b=>b.classList.toggle('on',b.dataset.theme===cur));
  btns.forEach(b=>b.addEventListener('click',()=>{
    cur=b.dataset.theme;
    lsSet('genshinArenaTheme',cur);
    paint();
    toast('场地主题：'+THEMES[cur].name+'·'+THEMES[cur].elem);
  }));
  paint();
})();
$('#btn-save').addEventListener('click',saveConfig);
$('#btn-start').addEventListener('click',startBattle);
$('#btn-random').addEventListener('click',randomPick);
$('#btn-skills').addEventListener('click',()=>{
  if(!game) return;
  game.skillsOn=!game.skillsOn;
  skillsAuto=game.skillsOn;
  lsSet('genshinArenaSkills',skillsAuto?'1':'0');
  syncSkillsBtn(skillsAuto);
  toast(game.skillsOn?'技能与大招：已开启':'技能与大招：已关闭');
});
$('#btn-team-pass').addEventListener('click',()=>{
  teamPassThrough=!teamPassThrough;
  if(game) game.teamPass=teamPassThrough;
  lsSet('genshinArenaTeamPass',teamPassThrough?'1':'0');
  syncTeamPassBtn();
  toast(teamPassThrough?'同队穿透：开（队友不再互相弹开）':'同队穿透：关（队友会互相弹开）');
});
$('#btn-clear').addEventListener('click',()=>{teamRed=[];teamBlue=[];renderRoster();refreshStart();});
$('#btn-pause').addEventListener('click',()=>{
  if(!game) return;
  game.paused=!game.paused;
  $('#btn-pause').textContent=game.paused?'继续':'暂停';
});
$('#btn-speed').addEventListener('click',()=>{
  if(!game) return;
  game.timeScale=game.timeScale===1?2:1;
  $('#btn-speed').textContent='速度 '+game.timeScale+'x';
  $('#btn-speed').classList.toggle('on',game.timeScale===2);
});
$('#btn-sound').addEventListener('click',()=>{
  ensureAudio();
  sound.on=!sound.on;
  $('#btn-sound').textContent='音效 '+(sound.on?'开':'关');
  $('#btn-sound').classList.toggle('on',sound.on);
});
$('#btn-music').addEventListener('click',()=>{
  musicOn=!musicOn;
  lsSet('genshinArenaMusic',musicOn?'1':'0');
  $('#btn-music').textContent='音乐 '+(musicOn?'开':'关');
  $('#btn-music').classList.toggle('on',musicOn);
  if(game){
    if(musicOn) playThemeMusic(game.themeKey);
    else stopThemeMusic();
  }
  toast(musicOn?'主题音乐：已开启（战斗开始时播放当前国家主题曲）':'主题音乐：已关闭');
});
function castSelected(which){
  if(!game) return;
  const f=game.fighters.find(x=>x.id===game.selectedId);
  if(f) game.castSkill(f,which);
}
$('#btn-skill-e').addEventListener('click',()=>castSelected('e'));
$('#btn-skill-q').addEventListener('click',()=>castSelected('q'));
$('#btn-exit').addEventListener('click',()=>{
  if(game){ game.destroy(); game=null; }
  stopThemeMusic();
  showView('sel');
});
$('#btn-again').addEventListener('click',startBattle);
$('#btn-reselect').addEventListener('click',()=>{
  if(game){ game.destroy(); game=null; }
  stopThemeMusic();
  showView('sel');
});
document.addEventListener('keydown',e=>{
  if(!views.battle.classList.contains('active')||!game) return;
  if(e.code==='Space'){
    e.preventDefault();
    game.paused=!game.paused;
    $('#btn-pause').textContent=game.paused?'继续':'暂停';
  }else if(e.key==='e'||e.key==='E'){
    e.preventDefault();
    const f=game.fighters.find(x=>x.id===game.selectedId);
    if(f) game.castSkill(f,'e');
  }else if(e.key==='q'||e.key==='Q'){
    e.preventDefault();
    const f=game.fighters.find(x=>x.id===game.selectedId);
    if(f) game.castSkill(f,'q');
  }
});

/* ================= 初始化 ================= */
loadConfig();
renderRoster();
refreshStart();
</script>
