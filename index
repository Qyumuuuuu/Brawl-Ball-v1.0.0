/* ================= 音频 ================= */
function ensureAudio(){
  if(!sound.ctx){
    const AC=window.AudioContext||window.webkitAudioContext;
    if(AC) sound.ctx=new AC();
  }
  if(sound.ctx&&sound.ctx.state==='suspended') sound.ctx.resume();
}
function playHit(){
  if(!sound.on||!sound.ctx) return;
  const t=sound.ctx.currentTime;
  // 低频打击感 + 高频脆响
  const o1=sound.ctx.createOscillator(), g1=sound.ctx.createGain();
  o1.type='triangle'; o1.frequency.setValueAtTime(180,t); o1.frequency.exponentialRampToValueAtTime(75,t+0.1);
  g1.gain.setValueAtTime(0.5,t); g1.gain.exponentialRampToValueAtTime(0.001,t+0.15);
  o1.connect(g1).connect(sound.ctx.destination); o1.start(t); o1.stop(t+0.16);
  const o2=sound.ctx.createOscillator(), g2=sound.ctx.createGain();
  o2.type='square'; o2.frequency.setValueAtTime(950,t);
  g2.gain.setValueAtTime(0.16,t); g2.gain.exponentialRampToValueAtTime(0.001,t+0.06);
  o2.connect(g2).connect(sound.ctx.destination); o2.start(t); o2.stop(t+0.07);
}
function playKill(){
  if(!sound.on||!sound.ctx) return;
  const t=sound.ctx.currentTime;
  [520,660].forEach((f,i)=>{
    const o=sound.ctx.createOscillator(), g=sound.ctx.createGain();
    o.type='sine'; o.frequency.value=f;
    g.gain.setValueAtTime(0.22,t+i*0.08); g.gain.exponentialRampToValueAtTime(0.001,t+i*0.08+0.22);
    o.connect(g).connect(sound.ctx.destination); o.start(t+i*0.08); o.stop(t+i*0.08+0.24);
  });
}
function playSkill(){
  if(!sound.on||!sound.ctx) return;
  const t=sound.ctx.currentTime;
  [440,660,880].forEach((f,i)=>{
    const o=sound.ctx.createOscillator(), g=sound.ctx.createGain();
    o.type='sine'; o.frequency.value=f;
    g.gain.setValueAtTime(0.16,t+i*0.05); g.gain.exponentialRampToValueAtTime(0.001,t+i*0.05+0.18);
    o.connect(g).connect(sound.ctx.destination); o.start(t+i*0.05); o.stop(t+i*0.05+0.2);
  });
}
function playUlt(){
  if(!sound.on||!sound.ctx) return;
  const t=sound.ctx.currentTime;
  [220,330,440,660].forEach((f,i)=>{
    const o=sound.ctx.createOscillator(), g=sound.ctx.createGain();
    o.type='sawtooth'; o.frequency.setValueAtTime(f,t+i*0.04);
    o.frequency.exponentialRampToValueAtTime(f*1.5,t+i*0.04+0.25);
    g.gain.setValueAtTime(0.12,t+i*0.04); g.gain.exponentialRampToValueAtTime(0.001,t+i*0.04+0.28);
    o.connect(g).connect(sound.ctx.destination); o.start(t+i*0.04); o.stop(t+i*0.04+0.3);
  });
}

/* ================= 战斗逻辑 ================= */
class Game{
  constructor(){
    this.fighters=[];
    this.particles=[]; this.texts=[]; this.shocks=[]; this.projectiles=[];
    // 特效对象池：死亡特效对象回收复用，不再反复 new/GC；fxCaps 为各类型数量上限（随画质等级调整）
    this._pools={particle:[],text:[],shock:[]};
    this.fxCaps={particle:600,text:80,shock:60};
    this.acc=0;              // 固定时间步累加器
    // 帧率自适应：每秒统计，fpsLevel 0=原生 1=降一档 2=最低档
    this.fpsAcc=0; this.fpsFrames=0; this.fpsLevel=0; this.fpsLow=0; this.fpsHigh=0;
    this.timed=[]; this.cyclones=[]; this.domains=[]; this.lines=[]; this.gates=[];
    this.ores=[]; this.pills=[];   // 岩结晶小球（己方捡盾）/ 草水扣血球（对面碰到扣血）
    this.qCount={red:0,blue:0};
    this.t=0; this.hits=0; this.totalDmg=0; this.reactions=0; this.rxnCounts={}; this.status='running';
    this.timeScale=1; this.paused=false; this.shake=0;
    this.timeLimit=180; // 超时判定：3 分钟
    this.theme=THEMES[lsGet('genshinArenaTheme')]||THEMES.liyue;
    this.themeKey=lsGet('genshinArenaTheme')||'liyue';
    this.skillsOn=skillsAuto;   // 技能/大招总开关（观战默认开启）
    this.teamPass=teamPassThrough; // 同队穿透（默认关闭，保持弹开手感）
    this.selectedId=null;
    this.hudRefs=[];
    this.teamStats={};
    this.finishTimer=null;   // 结算延时器：退出/重开时要清掉，避免旧局突然弹出结算
    this.lastTime=performance.now();
    this.rafId=null;
    this.fieldW=field.w; this.fieldH=field.h;
    this.zone={x:0,y:0,w:this.fieldW,h:this.fieldH}; // 当前有效场地（缩圈用）
    this.zoneWarned=false;
    this.slowmo=0;           // 终局慢镜头剩余时间
    this.maxHit={dmg:0,src:'',target:'',rxn:null};
    this.firstBlood=null;
    this.camZoom=1; this.camX=this.fieldW/2; this.camY=this.fieldH/2; this.camFocus=null; // 击杀镜头
    this.reactionLog=[]; this.bestCombo=0; this.bestComboTypes=null; this.comboUntil=0;   // 元素连携
    this._clockSec=-1;
    // 场地越大球速越快，保持碰撞节奏
    const speedScale=Math.min(1.7,Math.max(0.75,Math.sqrt(this.fieldW*this.fieldH/(1200*640))));
    const list=[...teamRed.map(s=>({...s,team:'red'})),...teamBlue.map(s=>({...s,team:'blue'}))];
    list.forEach(item=>{
      const hp=item.hp, atk=item.atk;   // 直接用选人界面的数值（BALANCE 已作为初始值写入槽位）
      const r=34+Math.min(hp,4500)/4500*7;
      this.fighters.push({id:item.roster.id,name:item.roster.name,title:item.roster.title,elem:item.roster.elem,
        img:item.roster.img,team:item.team,hp,maxHp:hp,atk,speed:item.roster.speed*speedScale,
        r,x:0,y:0,vx:0,vy:0,cd:{},flash:0,hitKick:0,dead:false,alpha:1,dmgDealt:0,dmgTaken:0,kills:0,
        ghostHp:hp,lastHurt:-9,pendingHeal:0,freezeImmune:0,reactionCd:0,lastZoneHurt:-9,
        attached:{elem:null,t:0}, dot:{elem:null,dps:0,t:0,src:null}, vuln:{mult:1,t:0}, shield:{t:0,val:0},
        skillCd:{e:0,q:0}, boost:{mult:1,t:0}, energy:0});
    });
    const m=40;
    for(const f of this.fighters){
      for(let k=0;k<400;k++){
        const x=m+f.r+Math.random()*(this.fieldW-2*(m+f.r));
        const y=m+f.r+Math.random()*(this.fieldH-2*(m+f.r));
        if(this.fighters.every(o=>o===f||Math.hypot(o.x-x,o.y-y)>(o.r+f.r)*1.6)){
          f.x=x; f.y=y; break;
        }
      }
      const a=Math.random()*Math.PI*2;
      f.vx=Math.cos(a)*f.speed; f.vy=Math.sin(a)*f.speed;
    }
    this.resize();
    // 离屏背景缓存：静态场地层只绘制一次（bg 图异步加载，完成后重建）
    this.bgCache=document.createElement('canvas');
    this.bgCacheReady=false;
    this.buildBgCache();
    const _bgi=bgImgs[this.themeKey];
    if(_bgi){
      if(!(_bgi.complete&&_bgi.naturalWidth>0)){
        _bgi.addEventListener('load', ()=>{ if(this.rafId!==null) this.buildBgCache(); });
      }
    }
    this.onResize=()=>this.resize();
    window.addEventListener('resize',this.onResize);
    banner('红蓝对决开始！','win');
    this.loop=(now)=>{
      if(this.rafId===null) return;
      // 真实帧 dt：夹住负值与切后台跳变（0.1 上限）
      const dt=Math.max(0,Math.min((now-this.lastTime)/1000,0.1)); this.lastTime=now;
      if(!this.paused){
        // 固定时间步：累加器吃真实帧 dt，慢镜/时间缩放通过倍率实现；acc 上限 0.25 防螺旋死亡
        const stepScale=this.timeScale*(this.slowmo>0?0.35:1);
        this.acc=Math.min(this.acc+dt*stepScale,0.25);
        let guard=0;
        while(this.acc>=FIXED-1e-9 && guard<10){
          this.tick(FIXED);
          this.acc-=FIXED;
          guard++;
        }
        if(guard>=10) this.acc=0;
      }
      this.draw();
      this.updateHud();
      // 帧率自适应：每秒统计实际 fps，低配自动降画质
      this.fpsAcc+=dt; this.fpsFrames++;
      if(this.fpsAcc>=1){
        const fps=this.fpsFrames/this.fpsAcc;
        this.fpsAcc=0; this.fpsFrames=0;
        this.adaptFps(fps);
      }
      this.rafId=requestAnimationFrame(this.loop);
    };
    this.rafId=requestAnimationFrame(this.loop);
  }

  /* 退出/重开时释放引用，避免 resize 监听与旧实例越攒越多 */
  destroy(){
    if(this.finishTimer){ clearTimeout(this.finishTimer); this.finishTimer=null; }
    if(this.rafId!==null){ cancelAnimationFrame(this.rafId); this.rafId=null; }
    if(this.onResize){ window.removeEventListener('resize',this.onResize); this.onResize=null; }
    this.hudRefs=[];
    this.status='ended';
  }

  resize(){
    if(this.dpr===undefined) this.dpr=Math.min(window.devicePixelRatio||1,2);
    const wrap=canvas.parentElement, dpr=this.dpr;
    const cw=wrap.clientWidth, ch=wrap.clientHeight;
    if(!cw||!ch) return;
    canvas.width=cw*dpr; canvas.height=ch*dpr;
    this.cw=cw; this.ch=ch;
    this.scale=Math.min(cw/this.fieldW,ch/this.fieldH);
    this.ox=(cw-this.fieldW*this.scale)/2;
    this.oy=(ch-this.fieldH*this.scale)/2;
  }

  /* 场地背景层（静态）：bg 实景图 cover + 暗色遮罩 + 四角装饰 + 边界 + 中心纹章，
     一次性绘制到离屏 canvas（1.5× 逻辑像素保证清晰度），draw 每帧只 drawImage */
  buildBgCache(){
    const Q=1.5, w=this.fieldW, h=this.fieldH;
    this.bgCache.width=Math.round(w*Q);
    this.bgCache.height=Math.round(h*Q);
    const c=this.bgCache.getContext('2d');
    c.setTransform(Q,0,0,Q,0,0);
    const bgi=bgImgs[this.themeKey];
    if(bgi&&bgi.complete&&bgi.naturalWidth>0){
      const iw=bgi.naturalWidth, ih=bgi.naturalHeight;
      const sc=Math.max(w/iw,h/ih);
      c.drawImage(bgi,(w-iw*sc)/2,(h-ih*sc)/2,iw*sc,ih*sc);
    }else{
      const g=c.createLinearGradient(0,0,0,h);
      g.addColorStop(0,this.theme.g0); g.addColorStop(1,this.theme.g1);
      c.fillStyle=g; c.fillRect(0,0,w,h);
    }
    c.fillStyle='rgba(6,10,18,.42)'; c.fillRect(0,0,w,h);
    const g2=c.createLinearGradient(0,0,0,h);
    g2.addColorStop(0,'rgba(6,10,18,0)');
    g2.addColorStop(1,'rgba(6,10,18,.38)');
    c.fillStyle=g2; c.fillRect(0,0,w,h);
    c.save(); c.strokeStyle=this.theme.edge; c.lineWidth=2.5;
    c.shadowColor=this.theme.dot; c.shadowBlur=8;
    const cc=36;
    [[0,0],[w,0],[0,h],[w,h]].forEach(([px,py])=>{
      const sx=px===0?1:-1, sy=py===0?1:-1;
      c.beginPath(); c.moveTo(px+sx*cc,py); c.lineTo(px,py+sy*cc); c.stroke();
      c.beginPath(); c.arc(px,py,6,0,Math.PI*2); c.stroke();
    });
    c.restore();
    c.save(); c.strokeStyle=this.theme.edge2; c.lineWidth=2; c.strokeRect(1,1,w-2,h-2); c.restore();
    c.save();
    c.strokeStyle=this.theme.dot; c.lineWidth=2;
    c.shadowColor=this.theme.dot; c.shadowBlur=10;
    const Rm=Math.min(w,h)*0.16;
    c.globalAlpha=0.22; c.beginPath(); c.arc(w/2,h/2,Rm,0,Math.PI*2); c.stroke();
    c.globalAlpha=0.36; c.beginPath(); c.arc(w/2,h/2,Rm*0.82,0,Math.PI*2); c.stroke();
    c.globalAlpha=0.32; c.lineWidth=3.5;
    for(const a of [0,Math.PI/2,Math.PI,Math.PI*3/2]){
      c.beginPath();
      c.moveTo(w/2+Math.cos(a)*Rm,h/2+Math.sin(a)*Rm);
      c.lineTo(w/2+Math.cos(a)*Rm*1.24,h/2+Math.sin(a)*Rm*1.24);
      c.stroke();
    }
    c.restore();
    this.bgCacheReady=true;
  }

  /* 特效生成（对象池复用）：kind = particle|text|shock，超上限回收最旧对象 */
  fx(kind,obj){
    const arr=kind==='particle'?this.particles:kind==='text'?this.texts:this.shocks;
    const pool=this._pools[kind];
    let p=pool.pop();
    if(p){ for(const k in p) delete p[k]; }
    else p={};
    Object.assign(p,obj);
    arr.push(p);
    const cap=this.fxCaps[kind];
    if(arr.length>cap){
      const old=arr.shift();
      pool.push(old);
    }
    return p;
  }

  /* 特效更新（原地清扫，不再每帧 filter 造新数组）：死亡对象回收到池 */
  sweepFx(kind,upd){
    const arr=kind==='particle'?this.particles:kind==='text'?this.texts:this.shocks;
    const pool=this._pools[kind];
    let n=0;
    for(let i=0;i<arr.length;i++){
      const p=arr[i];
      upd(p);
      if(p.life>0) arr[n++]=p;
      else pool.push(p);
    }
    arr.length=n;
  }

  /* 帧率自适应：fps<45 持续 2 秒降一档（dpr 2→1.5→1，粒子预算同步降）；
     fps>55 持续 5 秒回升一档（防抖，避免反复跳） */
  adaptFps(fps){
    if(fps<45){
      this.fpsHigh=0; this.fpsLow++;
      if(this.fpsLow>=2&&this.fpsLevel<2){
        this.fpsLevel++; this.fpsLow=0;
        this.applyPerfLevel();
      }
    }else if(fps>55){
      this.fpsLow=0; this.fpsHigh++;
      if(this.fpsHigh>=5&&this.fpsLevel>0){
        this.fpsLevel--; this.fpsHigh=0;
        this.applyPerfLevel();
      }
    }else{ this.fpsLow=0; this.fpsHigh=0; }
  }
  applyPerfLevel(){
    const base=Math.min(window.devicePixelRatio||1,2);
    this.dpr=this.fpsLevel===0?base:this.fpsLevel===1?Math.min(base,1.5):1;
    this.fxCaps.particle=this.fpsLevel===0?600:this.fpsLevel===1?400:250;
    this.fxCaps.text=this.fpsLevel===0?80:this.fpsLevel===1?60:50;
    this.fxCaps.shock=this.fpsLevel===0?60:this.fpsLevel===1?45:30;
    this.resize();
    toast(this.fpsLevel===0?'画质已自动恢复':'设备性能不足，已自动降低画质保证流畅');
  }

  /* 缩圈：55 秒开始，85 秒收到 50%，把对局逼进中心 */
  updateZone(){
    if(this.t<ZONE_START){ this.zone={x:0,y:0,w:this.fieldW,h:this.fieldH}; return; }
    const p=Math.min(1,(this.t-ZONE_START)/(ZONE_END-ZONE_START));
    const e=p*p*(3-2*p);
    const k=1-(1-ZONE_MIN)*e;
    const w=this.fieldW*k, h=this.fieldH*k;
    this.zone={x:(this.fieldW-w)/2,y:(this.fieldH-h)/2,w,h};
  }

  /* 镜头焦点：击杀时轻推近，终局推得更近 */
  focusCamera(x,y,zoom,dur){
    this.camFocus={x,y,zoom,ttl:dur,max:dur};
  }
  updateCamera(dt){
    let tz=1, tx=this.fieldW/2, ty=this.fieldH/2;
    if(this.camFocus){
      this.camFocus.ttl-=dt;
      if(this.camFocus.ttl<=0){ this.camFocus=null; }
      else{ tz=this.camFocus.zoom; tx=this.camFocus.x; ty=this.camFocus.y; }
    }
    const k=Math.min(1,dt*4.5);
    this.camZoom+=(tz-this.camZoom)*k;
    this.camX+=(tx-this.camX)*k;
    this.camY+=(ty-this.camY)*k;
    const sc=this.scale||1, cw=this.cw||this.fieldW, ch=this.ch||this.fieldH;
    const halfW=Math.min(this.fieldW/2, cw/(2*sc*this.camZoom));
    const halfH=Math.min(this.fieldH/2, ch/(2*sc*this.camZoom));
    this.camX=Math.max(halfW,Math.min(this.fieldW-halfW,this.camX));
    this.camY=Math.max(halfH,Math.min(this.fieldH-halfH,this.camY));
  }

  /* 元素连携：6 秒内连续触发的反应次数，>=3 时在右下角播报 */
  noteReaction(name){
    this.reactionLog.push({t:this.t,name});
    const cut=this.t-6;
    while(this.reactionLog.length&&this.reactionLog[0].t<cut) this.reactionLog.shift();
    const n=this.reactionLog.length;
    if(n>this.bestCombo){
      this.bestCombo=n;
      const types={};
      for(const e of this.reactionLog) types[e.name]=(types[e.name]||0)+1;
      this.bestComboTypes=types;
    }
    if(n>=3){
      this.comboUntil=this.t+2.2;
      if(comboEl){
        comboEl.innerHTML='元素连携 ×<b>'+n+'</b>';
        comboEl.classList.add('show');
        comboEl.classList.remove('pop');
        void comboEl.offsetWidth;
        comboEl.classList.add('pop');
      }
      if(n===6||n===10) this.addFeed('<span>元素连携 ×'+n+'</span>','sys');
    }
  }

  /* 场边击杀播报（最多 4 条，6 秒自动消失） */
  addFeed(html,cls){
    if(!feedEl) return;
    const d=document.createElement('div');
    d.className='feed-item'+(cls?' '+cls:'');
    d.innerHTML=html;
    feedEl.appendChild(d);
    while(feedEl.children.length>4) feedEl.removeChild(feedEl.children[0]);
    setTimeout(()=>{ if(d.parentNode) d.parentNode.removeChild(d); },6000);
  }

  recordHit(src,target,dmg){
    if(!isFinite(dmg)) return;
    if(dmg>this.maxHit.dmg){
      this.maxHit={dmg:Math.round(dmg),src:src?src.name:'?',target:target?target.name:'?',rxn:(target&&target.lastRxn)||null};
    }
  }

  tick(dt){
    if(this.status==='ended') return;
    // 固定步长：dt 恒为 FIXED；慢镜/时间缩放已在 loop 累加器倍率中处理
    if(this.slowmo>0) this.slowmo=Math.max(0,this.slowmo-dt);
    this.t+=dt;
    this.updateZone();
    this.updateCamera(dt);
    if(this.comboUntil&&this.t>this.comboUntil){ this.comboUntil=0; if(comboEl) comboEl.classList.remove('show'); }
    if(!this.zoneWarned&&this.t>=ZONE_START){
      this.zoneWarned=true;
      banner('场地开始收缩！','kill');
      this.addFeed('<span>场地开始收缩 · 决战阶段</span>','sys');
    }
    // 超时判定：3 分钟到 → 按存活数优先、其次剩余血量比例判胜负
    if(this.status==='running'&&this.t>=this.timeLimit){
      this.status='over';
      const score=team=>{
        const fs=this.fighters.filter(f=>f.team===team);
        const alive=fs.filter(f=>!f.dead).length;
        const hpRatio=fs.reduce((s,f)=>s+(f.dead?0:f.hp/f.maxHp),0);
        return alive*1000+hpRatio;
      };
      const rs=score('red'), bs=score('blue');
      this.finishTimer=setTimeout(()=>this.finish(rs>bs?'red':bs>rs?'blue':null,'timeout'),800);
    }
    const alive=this.fighters.filter(f=>!f.dead);
    const z=this.zone;
    for(const f of alive){
      if(f.stun&&f.stun.t>0){ f.vx=0; f.vy=0; continue; }
      // 石化/冻结结束后速度曾被清零：重新给一个随机方向的速度，否则角色会永久静止
      if(Math.hypot(f.vx,f.vy)<f.speed*0.35){
        const a=Math.random()*Math.PI*2;
        f.vx=Math.cos(a)*f.speed; f.vy=Math.sin(a)*f.speed;
      }
      f.x+=f.vx*dt; f.y+=f.vy*dt;
      if(f.x<z.x+f.r){f.x=z.x+f.r;f.vx=Math.abs(f.vx);}
      if(f.x>z.x+z.w-f.r){f.x=z.x+z.w-f.r;f.vx=-Math.abs(f.vx);}
      if(f.y<z.y+f.r){f.y=z.y+f.r;f.vy=Math.abs(f.vy);}
      if(f.y>z.y+z.h-f.r){f.y=z.y+z.h-f.r;f.vy=-Math.abs(f.vy);}
    }
    for(let i=0;i<alive.length;i++)for(let j=i+1;j<alive.length;j++){
      this.resolveCollision(alive[i],alive[j]);
    }
    // 特效更新：原地清扫 + 死亡对象回池（数量上限在 fx() 内处理，不再 filter 造新数组）
    this.sweepFx('particle',p=>{p.x+=(p.vx||0)*dt;p.y+=(p.vy||0)*dt;p.life-=dt;});
    this.sweepFx('text',t=>{if(!t.maxLife)t.maxLife=t.life;t.y-=20*dt;t.life-=dt;});
    this.sweepFx('shock',s=>{s.r+=(s.vr||140)*dt;s.life-=dt;});
    if(this.shake>0) this.shake=Math.max(0,this.shake-dt);
    for(const f of this.fighters){
      // 延迟血量（白/绿条）：死亡即消；1 秒内没变化则回血追平或白条缓慢降到当前血量
      if(f.dead){ f.ghostHp=0; f.pendingHeal=0; }
      else if(this.t-f.lastHurt>1){
        if(f.pendingHeal>0){          // 回血：血量缓慢涨向绿色目标条
          const inc=Math.min(f.pendingHeal, f.maxHp*0.3*dt);
          f.pendingHeal-=inc; f.hp=Math.min(f.maxHp, f.hp+inc);
          f.ghostHp=Math.min(f.maxHp, f.hp+f.pendingHeal);
        }else{                        // 扣血：白条缓慢降到当前血量
          f.ghostHp=Math.max(f.hp, f.ghostHp-f.maxHp*0.18*dt);
        }
      }
      if(f.flash>0) f.flash-=dt;
      if(f.hitKick>0) f.hitKick-=dt;
      if(f.dead){
        // 阵亡球淡出（爆炸特效结束后灰影消失，不占场地）
        if(f.alpha>0) f.alpha=Math.max(0,f.alpha-dt*1.4);
        continue;
      }
      if(f.freezeImmune>0) f.freezeImmune-=dt;
      if(f.reactionCd>0) f.reactionCd-=dt;
      if(f.attached.t>0){ f.attached.t-=dt; if(f.attached.t<=0) f.attached.elem=null; }
      // 缩圈外持续伤害：圆心在圈外按 3% 最大生命/秒扣血（每 0.5s 一跳），圈外不再是安全区
      if(f.x<z.x||f.x>z.x+z.w||f.y<z.y||f.y>z.y+z.h){
        if(this.t-f.lastZoneHurt>=0.5){
          f.lastZoneHurt=this.t;
          const zd=Math.max(1,Math.round(f.maxHp*0.015));
          f.hp-=zd; f.dmgTaken+=zd; f.lastHurt=this.t; this.totalDmg+=zd; f.flash=Math.max(f.flash,0.15); f.hitKick=0.08;
          this.fx('text', {x:f.x,y:f.y-f.r-6,str:'场边 -'+zd,crit:false,life:0.8,elem:'anemo'});
          if(f.hp<=0&&!f.dead) this.eliminate(f,null);
        }
      }
      if(f.vuln.t>0) f.vuln.t-=dt;
      if(f.shield.t>0) f.shield.t-=dt;
      if(f.boost.t>0) f.boost.t-=dt;
      if(f.skillCd.e>0) f.skillCd.e-=dt;
      if(f.skillCd.q>0) f.skillCd.q-=dt;
      if(f.teamElectro&&f.teamElectro.t>0) f.teamElectro.t-=dt;
      if(f.teamReaction&&f.teamReaction.t>0) f.teamReaction.t-=dt;
      if(f.vampire&&f.vampire.t>0) f.vampire.t-=dt;
      if(f.gateBuff&&f.gateBuff.t>0) f.gateBuff.t-=dt;
      if(f.stun&&f.stun.t>0) f.stun.t-=dt;
      // 自动施放：战技每 5 秒一次；能量满 20 自动放大招（石化期间不施放；总开关关闭则不施放）
      if(this.skillsOn&&!(f.stun&&f.stun.t>0)){
        if(f.skillCd.e<=0) this.castSkill(f,'e');
        if(f.energy>=ENERGY_MAX&&f.skillCd.q<=0) this.castSkill(f,'q');
      }
      if(f.dot.t>0){
        f.dot.t-=dt;
        const d=f.dot.dps*dt;
        f.hp-=d; f.dmgTaken+=d; f.lastHurt=this.t; this.totalDmg+=d;
        this.recordHit(f.dot.src||null,f,d);
        if(f.dot.src&&!f.dot.src.dead) f.dot.src.dmgDealt+=d;
        f.flash=Math.max(f.flash,0.05);
        this.dotParticle(f);
        if(f.hp<=0&&!f.dead) this.eliminate(f,f.dot.src||this.fighters[0]);
      }
    }
    // 投射物
    for(let i=this.projectiles.length-1;i>=0;i--){
      const pr=this.projectiles[i];
      pr.x+=pr.vx*dt; pr.y+=pr.vy*dt; pr.life-=dt;
      if(pr.life<=0||pr.x<-60||pr.x>this.fieldW+60||pr.y<-60||pr.y>this.fieldH+60){ this.projectiles.splice(i,1); continue; }
      let hit=false;
      for(const o of this.fighters){
        if(o.dead||o.team===pr.team) continue;
        if(pr.hitSet&&pr.hitSet.has(o.id)) continue;
        if(Math.hypot(o.x-pr.x,o.y-pr.y)<o.r+pr.r){
          hit=true;
          if(!pr.hitSet) pr.hitSet=new Set();
          pr.hitSet.add(o.id);
          const dmg=Math.max(1,Math.round(pr.atk*pr.mult*(0.9+Math.random()*0.2)));
          this.fx('text', {x:o.x,y:o.y-o.r-6,str:'-'+dmg,crit:false,life:0.9,elem:pr.elem});
          o.hp-=dmg; o.dmgTaken+=dmg; o.lastHurt=this.t; this.totalDmg+=dmg; pr.src.dmgDealt+=dmg; o.flash=0.16;
          const pe=ELEM[pr.elem];
          for(let k=0;k<10;k++){
            const a=Math.random()*Math.PI*2, sp=60+Math.random()*140;
            this.fx('particle', {x:o.x,y:o.y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:0.4+Math.random()*0.3,r:2.5+Math.random()*2.5,color:pe.glow});
          }
          this.applyElement(o,pr.src);
          this.recordHit(pr.src,o,dmg);
          if(o.hp<=0&&!o.dead) this.eliminate(o,pr.src);
          if(pr.onHit) pr.onHit(o,pr);
          if(!pr.pierce) break;
        }
      }
      if(hit&&!pr.pierce) this.projectiles.splice(i,1);
    }
    // 延时队列（砂糖Q四段 / 万叶E延迟聚怪 / 万叶Q多段 / 凝光Q小球等）
    for(let i=this.timed.length-1;i>=0;i--){
      const ev=this.timed[i];
      if(this.t>=ev.at){ ev.fn(); this.timed.splice(i,1); }
    }
    // 领域：琴Q（减伤+回血）/ 迪奥娜Q（回血+增伤+间歇冰伤）
    for(let i=this.domains.length-1;i>=0;i--){
      const d=this.domains[i];
      d.life-=dt; d.acc=(d.acc||0)+dt;
      if(d.life<=0){ this.domains.splice(i,1); continue; }
      const inR=o=>Math.hypot(o.x-d.x,o.y-d.y)<d.R;
      if(d.type==='jean'){
        let tickHeal=false;
        if(d.acc>=1){ d.acc=0; tickHeal=true; }
        for(const o of this.fighters){
          if(o.dead||o.team!==d.team||!inR(o)) continue;
          o.mit={t:0.2};
          if(tickHeal) this.heal(o,0.025);
        }
      }else if(d.type==='diona'){
        let tickHeal=false;
        if(d.acc>=1){ d.acc=0; tickHeal=true; }
        for(const o of this.fighters){
          if(o.dead||o.team!==d.team||!inR(o)) continue;
          o.dionaBuff={t:0.2};
          if(tickHeal) this.heal(o,0.02);
        }
        if(d.accIce===undefined) d.accIce=0;
        d.accIce+=dt;
        if(d.accIce>=1.2){ d.accIce=0; this.skillAoe(d.owner,d.x,d.y,d.R,0.5); }
      }
    }
    // 旋风（温迪Q 持续吸附+间歇风伤）
    for(let i=this.cyclones.length-1;i>=0;i--){
      const c=this.cyclones[i];
      c.life-=dt; c.acc=(c.acc||0)+dt;
      if(c.life<=0){ this.cyclones.splice(i,1); continue; }
      for(const o of this.fighters){
        if(o.dead||o.team===c.team) continue;
        const dx=c.x-o.x, dy=c.y-o.y, dist=Math.hypot(dx,dy);
        if(dist>c.R+o.r||dist<0.01) continue;
        o.vx+=dx/dist*340*dt; o.vy+=dy/dist*340*dt;
      }
      if(c.acc>=1){ c.acc=0; this.skillAoe(c.owner,c.x,c.y,c.R,0.35); }
    }
    // 直线波（迪卢克Q 宽直线范围火伤，飞出场地消失）
    for(let i=this.lines.length-1;i>=0;i--){
      const L=this.lines[i];
      L.x+=L.vx*dt; L.y+=L.vy*dt; L.life-=dt;
      if(L.life<=0||L.x<-80||L.x>this.fieldW+80||L.y<-80||L.y>this.fieldH+80){ this.lines.splice(i,1); continue; }
      for(const o of this.fighters){
        if(o.dead||o.team===L.team||(L.hitSet&&L.hitSet.has(o.id))) continue;
        const dx=o.x-L.x, dy=o.y-L.y, along=dx*L.ux+dy*L.uy;
        if(along<-L.length||along>0) continue;
        const perp=Math.abs(-dx*L.uy+dy*L.ux);
        if(perp<L.width/2+o.r){
          if(!L.hitSet) L.hitSet=new Set();
          L.hitSet.add(o.id);
          const nx=Math.sign(o.x-L.x)||1, ny=Math.sign(o.y-L.y)||0;
          this.dealDamage(o,L.src,nx,ny,L.mult);
        }
      }
    }
    // 屏障（凝光E 己方角色穿过获得短时增伤）
    for(let i=this.gates.length-1;i>=0;i--){
      const g=this.gates[i];
      g.life-=dt;
      if(g.life<=0){ this.gates.splice(i,1); continue; }
      if(!g.prev) g.prev={};
      for(const o of this.fighters){
        if(o.dead||o.team!==g.team||o===g.owner) continue;
        const prev=g.prev[o.id];
        if(prev!==undefined&&((prev<g.x&&o.x>=g.x)||(prev>g.x&&o.x<=g.x))){
          o.gateBuff={mult:1.15,t:3.5};
          this.fx('text', {x:o.x,y:o.y-o.r-6,str:'穿过屏障 攻击提升',crit:false,life:1.0,color:'#f4e3b2'});
        }
        g.prev[o.id]=o.x;
      }
    }
    // 岩结晶小球：己方队友碰到拾取护盾（5%最大生命，6秒消失）
    for(let i=this.ores.length-1;i>=0;i--){
      const ore=this.ores[i];
      ore.t-=dt;
      if(ore.t<=0){ this.ores.splice(i,1); continue; }
      for(const f of this.fighters){
        if(f.dead||f.team!==ore.team) continue;
        if(Math.hypot(f.x-ore.x,f.y-ore.y)<f.r+ore.r){
          f.shield={t:3.5,val:f.maxHp*0.05};
          this.fx('text', {x:f.x,y:f.y-f.r-6,str:'护盾 +'+Math.round(f.maxHp*0.05),crit:false,life:1.0,color:'#f4e3b2'});
          this.ores.splice(i,1);
          break;
        }
      }
    }
    // 草水小球：对面角色碰到扣血（0.5×草角色攻击力，一次性）
    for(let i=this.pills.length-1;i>=0;i--){
      const pill=this.pills[i];
      pill.t-=dt;
      if(pill.t<=0){ this.pills.splice(i,1); continue; }
      for(const f of this.fighters){
        if(f.dead||f.team===pill.team) continue;
        if(Math.hypot(f.x-pill.x,f.y-pill.y)<f.r+pill.r){
          const d=Math.max(1,Math.round(pill.atk*0.5));
          f.hp-=d; f.dmgTaken+=d; f.lastHurt=this.t; this.totalDmg+=d; f.flash=0.2; f.hitKick=0.1;
          this.recordHit(pill.src||null,f,d);
          this.fx('text', {x:f.x,y:f.y-f.r-6,str:'-'+d,crit:false,life:0.9,elem:'dendro'});
          const pe=ELEM.dendro;
          for(let k=0;k<5;k++){
            const a=Math.random()*Math.PI*2, sp=50+Math.random()*120;
            this.fx('particle', {x:f.x,y:f.y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:0.35,r:2+Math.random()*2,color:pe.glow});
          }
          if(f.hp<=0&&!f.dead) this.eliminate(f,pill.src||this.fighters[0]);
          this.pills.splice(i,1);
          break;
        }
      }
    }
  }

  resolveCollision(a,b){
    if(this.teamPass&&a.team===b.team) return;   // 同队穿透：不弹开、不占位
    const dx=b.x-a.x, dy=b.y-a.y;
    const dist=Math.hypot(dx,dy), min=a.r+b.r;
    if(dist>=min) return;
    if(dist<0.01){   // 两球完全重叠：随机方向分离，防止永久卡死
      const ra=Math.random()*Math.PI*2;
      a.x-=Math.cos(ra)*min*0.5; a.y-=Math.sin(ra)*min*0.5;
      b.x+=Math.cos(ra)*min*0.5; b.y+=Math.sin(ra)*min*0.5;
      return;
    }
    const nx=dx/dist, ny=dy/dist, overlap=min-dist;
    a.x-=nx*overlap/2; a.y-=ny*overlap/2; b.x+=nx*overlap/2; b.y+=ny*overlap/2;
    const va=a.vx*nx+a.vy*ny, vb=b.vx*nx+b.vy*ny;
    const jx=(vb-va)*nx, jy=(vb-va)*ny;
    const jitter=0.94+Math.random()*0.12;
    a.vx+=(jx)*jitter; a.vy+=(jy)*jitter;
    b.vx-=jx*jitter;   b.vy-=jy*jitter;
    // 仅异队碰撞造成伤害
    if(a.team===b.team) return;
    const key=a.id+'|'+b.id, now=this.t;
    if(now-(a.cd[key]||-9)>=HIT_CD){
      a.cd[key]=now; b.cd[key]=now;
      this.hits++;
      this.hitFx(a.x,a.y,b.x,b.y,nx,ny);
      playHit();
      // dealDamage(target,attacker)：第一个参数是被打方，第二个是打人方
      // 石化者不能攻击 → 检查打人方（b 打 a 检查 b；a 打 b 检查 a）
      if(!a.dead&&!(b.stun&&b.stun.t>0)) this.dealDamage(a,b,nx,ny);
      if(!b.dead&&!(a.stun&&a.stun.t>0)) this.dealDamage(b,a,nx,ny);
    }
  }

  dealDamage(target,attacker,nx,ny,mult){
    let base=attacker.atk*(0.85+Math.random()*0.3)*(mult||1);
    if(attacker.boost&&attacker.boost.t>0) base*=attacker.boost.mult;
    const crit=Math.random()<CRIT_RATE;
    if(crit) base*=CRIT_MULT;
    // 元素反应结算
    const r=this.applyElement(target,attacker);
    let dmg=base*r.mult;
    // 砂糖E：全队反应增伤（只放大已触发的反应伤害）
    if(attacker.teamReaction&&attacker.teamReaction.t>0&&r.mult>1) dmg*=1.3;
    // 凝光E：穿过屏障后攻击提升
    if(attacker.gateBuff&&attacker.gateBuff.t>0) dmg*=attacker.gateBuff.mult;
    // 迪奥娜Q：领域内队友增伤
    if(attacker.dionaBuff&&attacker.dionaBuff.t>0) dmg*=1.1;
    // 琴Q：领域内减伤
    if(target.mit&&target.mit.t>0) dmg*=0.7;
    // 超导易伤
    if(target.vuln.t>0) dmg*=target.vuln.mult;
    dmg=Math.max(1,Math.round(dmg));
    // 护盾（量值制：吸收对应伤害后消耗，可被完全挡下）
    if(target.shield.t>0&&target.shield.val>0){
      const ab=Math.min(dmg,target.shield.val);
      dmg-=ab; target.shield.val-=ab;
      if(target.shield.val<=0) target.shield.t=0;
      dmg=Math.max(0,Math.round(dmg));
    }
    target.hp-=dmg; target.dmgTaken+=dmg; target.lastHurt=this.t; this.totalDmg+=dmg; attacker.dmgDealt+=dmg; target.flash=0.26; target.hitKick=0.18;
    this.recordHit(attacker,target,dmg);
    // 受击特效：红色碎片溅射 + 受击震环
    for(let k=0;k<8;k++){
      const aa=Math.random()*Math.PI*2, sp=90+Math.random()*170;
      this.fx('particle', {x:target.x,y:target.y,vx:Math.cos(aa)*sp,vy:Math.sin(aa)*sp,life:0.36,maxLife:0.36,r:2.2+Math.random()*2.8,color:Math.random()<0.55?'#ff4d4d':'#ffb0b0'});
    }
    this.fx('shock', {x:target.x,y:target.y,r:target.r*0.5,life:0.28,vr:320,color:'#ff6b6b'});
    attacker.energy=Math.min(ENERGY_MAX,attacker.energy+1); // 攻击命中攒 1 点元素能量
    this.fx('text', {x:target.x+(Math.random()*16-8), y:target.y-target.r-6, str:crit?'暴击 '+dmg:'-'+dmg, crit, life:0.9, elem:attacker.elem});
    // 雷电将军E：全队攻击附带雷元素伤害（同样受护盾吸收）
    if(attacker.teamElectro&&attacker.teamElectro.t>0){
      let ed=Math.max(1,Math.round(attacker.atk*0.35));
      if(target.shield.t>0&&target.shield.val>0){
        const ab2=Math.min(ed,target.shield.val);
        ed-=ab2; target.shield.val-=ab2;
        if(target.shield.val<=0) target.shield.t=0;
        ed=Math.max(0,Math.round(ed));
      }
      target.hp-=ed; target.dmgTaken+=ed; target.lastHurt=this.t; this.totalDmg+=ed; attacker.dmgDealt+=ed;
      this.recordHit(attacker,target,ed);
      this.fx('text', {x:target.x+(Math.random()*16-8),y:target.y-target.r-24,str:'雷 '+ed,crit:false,life:0.8,elem:'electro'});
      const pe=ELEM.electro;
      for(let k=0;k<5;k++){
        const aa=Math.random()*Math.PI*2, sp=60+Math.random()*120;
        this.fx('particle', {x:target.x,y:target.y,vx:Math.cos(aa)*sp,vy:Math.sin(aa)*sp,life:0.35,r:2.5+Math.random()*2,color:pe.glow});
      }
      if(!target.attached.elem) target.attached={elem:'electro',t:ATTACH_T};
      if(target.hp<=0&&!target.dead) this.eliminate(target,attacker);
    }
    // 芭芭拉E：攻击命中为全队回一点血
    if(attacker.vampire&&attacker.vampire.t>0){
      for(const o of this.fighters){
        if(o.dead||o.team!==attacker.team) continue;
        this.heal(o,0.01);
      }
    }
    // 反应附加效果
    if(r.boom) this.boom(target,attacker,r.boom,nx,ny);
    if(r.dot){ target.dot={elem:attacker.elem, dps:attacker.atk*r.dot.dot*(attacker.teamReaction&&attacker.teamReaction.t>0?1.3:1), t:r.dot.dotT, src:attacker}; this.rxnElectroFx(target); } // 感电特效
    if(r.vuln){ target.vuln={mult:r.vuln.vuln, t:r.vuln.vulnT}; this.rxnCryoFx(target); } // 超导特效
    if(r.stun) this.freezeTarget(target,r.stun.stun); // 冻结：定身（带免疫期，避免永久控制）
    if(r.shield) attacker.shield={t:3.5,val:attacker.maxHp*0.05};
    if(r.knock){ target.vx+=(nx||0)*95; target.vy+=(ny||0)*95; }
    if(target.hp<=0&&!target.dead) this.eliminate(target,attacker);
  }

  // 元素附着与反应判定：返回本击修饰量；风/岩/草的特殊机制在此直接执行
  applyElement(target,attacker){
    const atkElem=attacker.elem, curElem=target.attached.elem;
    let rxn=null;
    target.lastRxn=null;
    if(curElem){
      if(curElem===atkElem){ target.attached.t=ATTACH_T; return NO_RXN; }   // 同元素刷新附着，不算反应，不受冷却
      if(target.reactionCd>0) return NO_RXN;   // 反应冷却中：本次不反应、附着保留（防止同一碰撞连续触发融化/蒸发）
      if(atkElem==='anemo'){ this.doSwirl(target,attacker,curElem); return NO_RXN; }
      if(atkElem==='geo'){ this.doCrystal(target,attacker); target.attached={elem:null,t:0}; return NO_RXN; }
      if(atkElem==='dendro'){ this.doDendro(target,attacker,curElem); return NO_RXN; }
      rxn=REACTIONS[atkElem+'|'+curElem]||REACTIONS[curElem+'|'+atkElem]||null;
      if(rxn&&rxn.stun&&target.freezeImmune>0){
        // 冻结免疫期：不消耗附着、不触发反应（避免水冰组合把对手永久锁死）
        return NO_RXN;
      }
      if(rxn){
        target.attached={elem:null,t:0};
        target.reactionCd=REACTION_ICD;
      }
    }else{
      // 风、岩、草不产生可反应附着，水火雷冰直接附着
      if(atkElem!=='anemo'&&atkElem!=='geo'&&atkElem!=='dendro') target.attached={elem:atkElem,t:ATTACH_T};
    }
    if(rxn){
      this.reactions++;
      this.rxnCounts[rxn.name]=(this.rxnCounts[rxn.name]||0)+1;
      target.lastRxn=rxn.name;
      this.noteReaction(rxn.name);
      this.fx('text', {x:target.x,y:target.y-target.r-32,str:rxn.name+'！',rxn:true,glow:rxn.color,life:1.15});
      if(rxn.mult) this.rxnMultFx(target,rxn); // 蒸发/融化增幅特效
      return {mult:rxn.mult||1, boom:rxn.boom?rxn:null, dot:rxn.dot?rxn:null, vuln:rxn.vuln?rxn:null, shield:!!rxn.shield, knock:!!rxn.knock, stun:rxn.stun?rxn:null};
    }
    return NO_RXN;
  }

  // 风扩散：以目标 2 倍半径为范围，对面角色受风伤(1.2×攻击)并挂上对应元素附着；清除目标自身附着
  doSwirl(target,attacker,elem){
    const R=target.r*2;
    this.reactions++;
    this.rxnCounts['扩散']=(this.rxnCounts['扩散']||0)+1;
    this.noteReaction('扩散');
    target.lastRxn='扩散';
    target.reactionCd=REACTION_ICD;
    this.fx('text', {x:target.x,y:target.y-target.r-32,str:'扩散！',rxn:true,color:'#a0f0d4',life:1.1});
    this.fx('shock', {x:target.x,y:target.y,r:target.r,life:0.4,vr:R/0.4,color:'#a0f0d4'});
    this.fx('shock', {x:target.x,y:target.y,r:target.r*0.5,life:0.3,vr:R/0.3,color:'#ffffff'}); // 风爆白环
    // 风卷粒子：绕目标螺旋上升
    for(let k=0;k<10;k++){
      const a=Math.random()*Math.PI*2, sp=60+Math.random()*150;
      this.fx('particle', {type:'mist',x:target.x,y:target.y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-70,life:0.4+Math.random()*0.3,maxLife:0.7,r:2.5+Math.random()*2.5,color:'#a0f0d4'});
    }
    for(const o of this.fighters){
      if(o.dead||o.team===attacker.team||o===target) continue;
      if(Math.hypot(o.x-target.x,o.y-target.y)<=R){
        const d=Math.max(1,Math.round(attacker.atk*SWIRL.mult*(0.85+Math.random()*0.3)));
        o.hp-=d; o.dmgTaken+=d; o.lastHurt=this.t; this.totalDmg+=d; attacker.dmgDealt+=d; o.flash=0.2; o.hitKick=0.1;
        o.attached={elem:elem,t:ATTACH_T};
        o.reactionCd=REACTION_ICD;   // 传染者同样进入冷却，防止刚被扩散就立刻被队友连锁反应
        this.fx('text', {x:o.x,y:o.y-o.r-6,str:'扩散 -'+d,crit:false,life:0.9,elem:'anemo'});
        const ec=ELEM[elem]||{glow:'#ffffff'};
        this.fx('shock', {x:o.x,y:o.y,r:o.r*0.6,life:0.3,vr:300,color:ec.glow}); // 传染处元素环
        for(let k=0;k<5;k++){
          const a=Math.random()*Math.PI*2, sp=50+Math.random()*120;
          this.fx('particle', {x:o.x,y:o.y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:0.4,r:2+Math.random()*2,color:Math.random()<0.5?'#a0f0d4':ec.glow});
        }
        if(o.hp<=0&&!o.dead) this.eliminate(o,attacker);
      }
    }
    target.attached={elem:null,t:0};
  }

  // 岩结晶：命中处生成小球，己方队友碰到获得少量护盾（5%最大生命）
  doCrystal(target,attacker){
    this.reactions++;
    this.rxnCounts['结晶']=(this.rxnCounts['结晶']||0)+1;
    this.noteReaction('结晶');
    target.lastRxn='结晶';
    target.reactionCd=REACTION_ICD;
    this.fx('text', {x:target.x,y:target.y-target.r-32,str:'结晶',rxn:true,color:'#f4e3b2',life:1.1});
    this.fx('shock', {x:target.x,y:target.y,r:target.r*0.5,life:0.35,vr:360,color:'#f4e3b2'});
    for(let k=0;k<8;k++){
      const a=Math.random()*Math.PI*2, sp=90+Math.random()*160;
      this.fx('particle', {type:'spark',x:target.x,y:target.y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:0.35,maxLife:0.35,r:2+Math.random()*1.5,color:Math.random()<0.6?'#f4e3b2':'#ffffff'});
    }
    this.ores.push({x:target.x,y:target.y,r:8,team:attacker.team,t:6});
  }

  // 草反应：水=原地扣血球 / 雷=受伤害增加 / 火=持续扣血直到附着消失；冰无定义（附着保留）
  doDendro(target,attacker,curElem){
    const nm=curElem==='hydro'?'绽放':curElem==='electro'?'激化':curElem==='pyro'?'燃烧':null;
    if(!nm) return;   // 草 + 冰没有反应，别把它算进反应数
    this.reactions++;
    this.rxnCounts[nm]=(this.rxnCounts[nm]||0)+1;
    this.noteReaction(nm);
    target.lastRxn=nm;
    target.reactionCd=REACTION_ICD;
    if(curElem==='hydro'){
      this.fx('text', {x:target.x,y:target.y-target.r-32,str:'绽放',rxn:true,color:'#b8e88a',life:1.1});
      this.fx('shock', {x:target.x,y:target.y,r:target.r*0.5,life:0.4,vr:420,color:'#b8e88a'});
      for(let k=0;k<12;k++){
        const a=Math.random()*Math.PI*2, sp=80+Math.random()*170;
        this.fx('particle', {x:target.x,y:target.y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:0.4+Math.random()*0.25,r:2.5+Math.random()*2.5,color:Math.random()<0.5?'#b8e88a':'#8fd0ff'});
      }
      this.pills.push({x:target.x,y:target.y,r:9,atk:attacker.atk,src:attacker,team:attacker.team,t:6});
      target.attached={elem:null,t:0};
    }else if(curElem==='electro'){
      this.fx('text', {x:target.x,y:target.y-target.r-32,str:'激化',rxn:true,color:'#e7c6ff',life:1.1});
      this.fx('shock', {x:target.x,y:target.y,r:target.r*0.6,life:0.35,vr:400,color:'#e7c6ff'});
      for(let k=0;k<8;k++){
        const a=Math.random()*Math.PI*2, sp=100+Math.random()*170;
        this.fx('particle', {type:'spark',x:target.x,y:target.y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:0.3,maxLife:0.3,r:2+Math.random()*2,color:Math.random()<0.5?'#e7c6ff':'#8fd0ff'});
      }
      target.vuln={mult:1.3,t:2};
      target.attached={elem:null,t:0};
    }else if(curElem==='pyro'){
      this.fx('text', {x:target.x,y:target.y-target.r-32,str:'燃烧',rxn:true,color:'#ffb35c',life:1.1});
      for(let k=0;k<10;k++){
        const a=Math.random()*Math.PI*2, sp=40+Math.random()*100;
        this.fx('particle', {type:'flame',x:target.x+Math.cos(a)*target.r*0.6,y:target.y+Math.sin(a)*target.r*0.6,
          vx:Math.cos(a)*sp*0.4,vy:Math.sin(a)*sp*0.4-55,life:0.4+Math.random()*0.3,maxLife:0.7,r:3+Math.random()*2.5,color:Math.random()<0.5?'#ff8a3d':'#ffd76a'});
      }
      // 保留火附着：持续扣血直到附着消失
      target.dot={elem:'dendro',dps:attacker.atk*0.4,t:target.attached.t,src:attacker};
    }
  }

  // 增幅类反应特效（蒸发/融化）：双冲击环 + 上升蒸汽/冰晶
  rxnMultFx(target,rxn){
    this.fx('shock', {x:target.x,y:target.y,r:target.r,life:0.32,vr:420,color:rxn.color});
    this.fx('shock', {x:target.x,y:target.y,r:target.r*0.6,life:0.24,vr:560,color:'#ffffff'});
    for(let k=0;k<14;k++){
      const a=Math.random()*Math.PI*2, sp=40+Math.random()*110;
      this.fx('particle', {type:'mist',x:target.x+Math.cos(a)*target.r*0.5,y:target.y+Math.sin(a)*target.r*0.5,
        vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-60,life:0.5+Math.random()*0.4,maxLife:0.9,r:3+Math.random()*3.5,color:rxn.color});
    }
  }
  // 感电特效：电弧链向附近敌方 + 电流粒子
  rxnElectroFx(target){
    const c='#8fd0ff';
    let chained=0;
    for(const o of this.fighters){
      if(chained>=2||o.dead||o.team===target.team||o===target) continue;
      if(Math.hypot(o.x-target.x,o.y-target.y)<220){
        this.fx('particle', {type:'bolt',x1:target.x,y1:target.y,x2:o.x,y2:o.y,seed:Math.random()*100,life:0.22,maxLife:0.25,color:c});
        chained++;
      }
    }
    for(let k=0;k<8;k++){
      const a=Math.random()*Math.PI*2, sp=60+Math.random()*130;
      this.fx('particle', {x:target.x+Math.cos(a)*target.r,y:target.y+Math.sin(a)*target.r,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:0.3+Math.random()*0.25,r:1.8+Math.random()*2,color:Math.random()<0.5?'#8fd0ff':'#ffffff'});
    }
    this.fx('shock', {x:target.x,y:target.y,r:target.r,life:0.25,vr:380,color:c});
  }
  // 超导特效：霜环扩散 + 雪花
  rxnCryoFx(target){
    this.fx('shock', {x:target.x,y:target.y,r:target.r*0.8,life:0.5,vr:300,color:'#d6f4ff'});
    this.fx('shock', {x:target.x,y:target.y,r:target.r*0.5,life:0.35,vr:420,color:'#ffffff'});
    for(let k=0;k<10;k++){
      const a=Math.random()*Math.PI*2, sp=30+Math.random()*80;
      this.fx('particle', {type:'snow',x:target.x+Math.cos(a)*target.r*0.6,y:target.y+Math.sin(a)*target.r*0.6,
        vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-30,life:0.6+Math.random()*0.4,maxLife:1,r:2+Math.random()*2,color:'#d6f4ff'});
    }
  }

  // 冻结：定身 + 解冻后的免疫期（防止水冰两队互相锁死）
  freezeTarget(target,dur){
    if(!target||target.dead||target.freezeImmune>0) return false;
    target.stun={t:dur||FREEZE_T,kind:'freeze'};
    target.freezeImmune=FREEZE_IMMUNE_T;
    target.reactionCd=Math.max(target.reactionCd||0,REACTION_ICD); // 冻结同样计入反应冷却
    target.vx=0; target.vy=0;
    this.rxnFreezeFx(target);
    return true;
  }
  rxnFreezeFx(target){
    this.fx('shock', {x:target.x,y:target.y,r:target.r*0.85,life:0.5,vr:320,color:'#bfefff'});
    this.fx('shock', {x:target.x,y:target.y,r:target.r*0.5,life:0.35,vr:470,color:'#ffffff'});
    for(let k=0;k<12;k++){
      const a=Math.random()*Math.PI*2, sp=35+Math.random()*90;
      this.fx('particle', {type:'snow',x:target.x+Math.cos(a)*target.r*0.6,y:target.y+Math.sin(a)*target.r*0.6,
        vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-45,life:0.55+Math.random()*0.4,maxLife:0.95,r:2+Math.random()*2,
        color:Math.random()<0.5?'#d6f4ff':'#ffffff'});
    }
  }

  // 超载 / 绽放：目标爆炸伤害 + 小范围溅射 + 击退
  boom(target,attacker,rxn,nx,ny){
    this.shake=Math.max(this.shake,0.32); // 爆炸屏幕震动
    const e=ELEM[attacker.elem];
    this.fx('shock', {x:target.x,y:target.y,r:target.r,life:0.5,vr:260,color:e.glow});
    this.fx('shock', {x:target.x,y:target.y,r:target.r*0.5,life:0.32,vr:520,color:'#ffffff'}); // 白热内环
    for(let i=0;i<16;i++){
      const a=Math.random()*Math.PI*2, sp=80+Math.random()*180;
      this.fx('particle', {x:target.x,y:target.y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:0.5+Math.random()*0.3,r:3+Math.random()*3,color:e.c});
    }
    for(let i=0;i<8;i++){
      const a=Math.random()*Math.PI*2, sp=120+Math.random()*200;
      this.fx('particle', {type:'spark',x:target.x,y:target.y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:0.3,maxLife:0.3,r:2.5+Math.random()*2,color:Math.random()<0.5?'#fff7e0':'#ffd76a'});
    }
    const rBoost=attacker.teamReaction&&attacker.teamReaction.t>0?1.3:1;
    const boomDmg=Math.max(1,Math.round(attacker.atk*rxn.boom*(0.9+Math.random()*0.2)*rBoost));
    target.lastRxn=rxn.name;
    target.hp-=boomDmg; target.dmgTaken+=boomDmg; target.lastHurt=this.t; this.totalDmg+=boomDmg; attacker.dmgDealt+=boomDmg;
    this.recordHit(attacker,target,boomDmg);
    this.fx('text', {x:target.x,y:target.y-target.r-6,str:'爆炸 '+boomDmg,crit:false,life:0.9,elem:attacker.elem});
    if(target.hp<=0&&!target.dead) this.eliminate(target,attacker);
    const R=140;
    for(const o of this.fighters){
      // 溅射只打“攻击者的敌人”（目标所在队）；之前写成了跳过目标队，反而炸到自己的队友
      if(o===target||o.dead||o.team===attacker.team) continue;
      if(Math.hypot(o.x-target.x,o.y-target.y)<R+o.r){
        const sd=Math.max(1,Math.round(attacker.atk*rxn.aoe*(0.9+Math.random()*0.2)*rBoost));
        o.hp-=sd; o.dmgTaken+=sd; o.lastHurt=this.t; this.totalDmg+=sd; attacker.dmgDealt+=sd; o.flash=0.15;
        this.fx('text', {x:o.x,y:o.y-o.r-6,str:'溅射 '+sd,crit:false,life:0.9,elem:attacker.elem});
        if(o.hp<=0&&!o.dead) this.eliminate(o,attacker);
      }
    }
  }

  // 感电 / 燃烧的持续伤害粒子
  dotParticle(f){
    if(Math.random()>0.4) return;
    const a=Math.random()*Math.PI*2, sp=20+Math.random()*40;
    if(f.dot.elem==='electro'){
      // 感电：蓝白电流跳动
      const e=ELEM.electro;
      this.fx('particle', {x:f.x+Math.cos(a)*f.r*0.6,y:f.y+Math.sin(a)*f.r*0.6,
        vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-22,life:0.3+Math.random()*0.25,r:1.6+Math.random()*1.8,color:Math.random()<0.5?e.glow:'#ffffff'});
    }else{
      // 燃烧：红橙火焰上飘收缩
      this.fx('particle', {type:'flame',x:f.x+Math.cos(a)*f.r*0.6,y:f.y+Math.sin(a)*f.r*0.6,
        vx:Math.cos(a)*sp*0.5,vy:Math.sin(a)*sp*0.5-52,life:0.35+Math.random()*0.3,maxLife:0.65,r:3+Math.random()*2.5,color:Math.random()<0.5?'#ff8a3d':'#ffd76a'});
    }
  }

  /* ---------- 技能系统 ---------- */
  select(id){
    const f=this.fighters.find(x=>x.id===id);
    if(!f||f.dead) return;
    this.selectedId=id;
  }

  nearestEnemy(f){
    let best=null, bd=1e9;
    for(const o of this.fighters){
      if(o.team===f.team||o.dead) continue;
      const d=(o.x-f.x)**2+(o.y-f.y)**2;
      if(d<bd){ bd=d; best=o; }
    }
    return best;
  }

  // 范围伤害：以 (x,y) 为中心 R 内所有异队敌人
  skillAoe(f,x,y,R,mult,onHit){
    for(const o of this.fighters){
      if(o.dead||o.team===f.team) continue;
      if(Math.hypot(o.x-x,o.y-y)>R) continue;
      const nx=Math.sign(o.x-x)||1, ny=Math.sign(o.y-y)||0;
      this.dealDamage(o,f,nx,ny,mult);
      if(onHit) onHit(o);
    }
  }

  heal(f,ratio){
    const h=Math.round(f.maxHp*ratio);
    if(h<=0) return;
    const actual=Math.min(h, f.maxHp-f.hp);   // 实际能回的血量
    if(actual<=0) return;
    f.pendingHeal+=actual;                     // 先挂起：血条先显示绿色目标条，血量稍后缓慢追上去
    f.ghostHp=Math.min(f.maxHp, f.hp+f.pendingHeal);
    f.lastHurt=this.t;
    this.fx('text', {x:f.x,y:f.y-f.r-6,str:'+'+actual,heal:true,crit:false,life:1.0});
    this.fx('particle', {x:f.x,y:f.y,vx:0,vy:-30,life:0.6,r:4,color:'#8affb0'});
  }

  // 直线投射物（向最近敌人发射）
  fireProj(f,tg,speed,mult,opts){
    if(!tg) return;
    const a=Math.atan2(tg.y-f.y,tg.x-f.x), e=ELEM[f.elem];
    this.projectiles.push(Object.assign({
      x:f.x,y:f.y, vx:Math.cos(a)*speed, vy:Math.sin(a)*speed,
      r:opts.r||10, life:opts.life||2.2, color:e.glow, elem:f.elem, team:f.team,
      atk:f.atk, mult, src:f, pierce:false, hitSet:null, onHit:null
    },opts));
  }

  castSkill(f,which){
    if(this.status!=='running'||!f||f.dead||!this.skillsOn) return;
    const sk=SKILLS[f.id]&&SKILLS[f.id][which];
    if(!sk) return;
    if(which==='e'){
      if(f.skillCd.e>0) return;
      f.skillCd.e=sk.cd||E_CD;                          // 战技冷却：优先用角色自己的 cd
      f.energy=Math.min(ENERGY_MAX,f.energy+5);          // 释放战技 +5 元素能量
    }else{
      if(f.energy<ENERGY_MAX||f.skillCd.q>0) return;     // 大招：满能量且冷却完毕
      f.energy=0;
      f.skillCd.q=sk.cd||ULT_CD;                         // 大招冷却：优先用角色自己的 cd
    }
    if(which==='q'){ playUlt(); this.qCount[f.team]++; } else playSkill();
    const e=ELEM[f.elem];
    this.fx('shock', {x:f.x,y:f.y,r:f.r+4,life:0.45,vr:190,color:e.glow});
    const tg=this.nearestEnemy(f);
    switch(f.id){
      case 'zhongli': which==='e'?this.zhongliE(f):this.zhongliQ(f); break;
      case 'hutao':   which==='e'?this.hutaoE(f):this.hutaoQ(f); break;
      case 'raiden':  which==='e'?this.raidenE(f):this.raidenQ(f); break;
      case 'ganyu':   which==='e'?this.ganyuE(f,tg):this.ganyuQ(f); break;
      case 'furina':  which==='e'?this.furinaE(f,tg):this.furinaQ(f); break;
      case 'nahida':  which==='e'?this.nahidaE(f,tg):this.nahidaQ(f); break;
      case 'venti':   which==='e'?this.ventiE(f,tg):this.ventiQ(f); break;
      case 'klee':    which==='e'?this.kleeE(f,tg):this.kleeQ(f); break;
      case 'diluc':     which==='e'?this.dilucE(f,tg):this.dilucQ(f,tg); break;
      case 'jean':      which==='e'?this.jeanE(f,tg):this.jeanQ(f); break;
      case 'mona':      which==='e'?this.tplShot(f,tg,380,1.7,10):this.tplAoe(f,1.8); break;
      case 'keqing':    which==='e'?this.tplShot(f,tg,420,1.7,9):this.tplAoe(f,2.0); break;
      case 'qiqi':      which==='e'?(this.tplShot(f,tg,360,1.4,9),this.tplHeal(f,0.1)):(this.tplAoe(f,1.2),this.tplTeamHeal(f,0.25)); break;
      case 'tartaglia': which==='e'?this.tplShot(f,tg,400,1.8,11):this.tplNuke(f,tg,3.0); break;
      case 'albedo':    which==='e'?(this.tplAoeNear(f,180,1.4),this.tplShield(f,3.5)):(this.tplAoe(f,1.6),this.tplShield(f,4)); break;
      case 'xiao':      which==='e'?this.xiaoE(f,tg):this.xiaoQ(f); break;
      case 'eula':      which==='e'?this.eulaE(f):this.tplNuke(f,tg,3.2); break;
      case 'kazuha':    which==='e'?this.kazuhaE(f):this.kazuhaQ(f); break;
      case 'amber':     which==='e'?this.tplShot(f,tg,360,1.5,9):this.tplAoe(f,1.5); break;
      case 'kaeya':     which==='e'?this.tplNuke(f,tg,1.6):this.tplAoe(f,1.6); break;
      case 'lisa':      which==='e'?this.tplAoeNear(f,200,1.8):this.tplAoe(f,2.0); break;
      case 'barbara':   which==='e'?this.barbaraE(f):this.barbaraQ(f); break;
      case 'razor':     which==='e'?this.tplNuke(f,tg,1.7):(this.tplBoost(f,1.4,4),this.tplAoe(f,1.6)); break;
      case 'bennett':   which==='e'?this.tplNuke(f,tg,1.5):(this.tplAoe(f,1.5),this.tplTeamHeal(f,0.2),this.tplBoost(f,1.3,4)); break;
      case 'noelle':    which==='e'?this.noelleE(f):this.noelleQ(f); break;
      case 'fischl':    which==='e'?this.tplShot(f,tg,380,1.6,9):this.tplAoe(f,1.6); break;
      case 'sucrose':   which==='e'?this.sucroseE(f):this.sucroseQ(f); break;
      case 'beidou':    which==='e'?(this.tplShield(f,4),this.tplAoeNear(f,200,1.5)):this.tplAoe(f,2.0); break;
      case 'ningguang': which==='e'?this.ningguangE(f):this.ningguangQ(f); break;
      case 'xiangling': which==='e'?this.tplBoomShot(f,tg,360,1.6,10):this.tplAoe(f,1.8); break;
      case 'xingqiu':   which==='e'?(this.tplNuke(f,tg,1.5),this.tplShield(f,3.5)):(this.tplAoe(f,1.6),this.tplTeamHeal(f,0.15)); break;
      case 'chongyun':  which==='e'?this.tplAoeNear(f,180,1.5):this.tplAoe(f,1.8); break;
      case 'diona':     which==='e'?this.dionaE(f):this.dionaQ(f); break;
      case 'xinyan':    which==='e'?(this.tplAoeNear(f,190,1.4),this.tplShield(f,3.5)):this.tplAoe(f,1.8); break;
      case 'rosaria':   which==='e'?this.tplPierce(f,tg,380,1.5,9):this.tplAoe(f,1.7); break;
      case 'yanfei':    which==='e'?this.tplNuke(f,tg,1.8):this.tplAoe(f,1.9); break;
    }
  }

  // —— 钟离 岩（E 护盾 / Q 全场石化） ——
  zhongliE(f){
    f.shield={t:6,val:f.maxHp*0.25};
    this.fx('shock', {x:f.x,y:f.y,r:f.r+6,life:0.6,vr:300,color:'#f4e3b2'});
    this.fx('text', {x:f.x,y:f.y-f.r-10,str:'玉璋护盾',crit:false,life:1.0,color:'#f4e3b2'});
